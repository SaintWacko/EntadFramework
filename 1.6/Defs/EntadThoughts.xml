<Defs>
  <!-- Mood from entad items worn or wielded. The value is summed from the items' modifiers by Thought_EntadEquipped. -->
  <ThoughtDef>
    <defName>Entad_EquippedMood</defName>
    <thoughtClass>EntadFramework.Thought_EntadEquipped</thoughtClass>
    <workerClass>EntadFramework.ThoughtWorker_EntadEquipped</workerClass>
    <stages>
      <li>
        <label>entad item</label>
        <description>Something about the strange items I carry affects my mood.</description>
        <baseMoodEffect>0</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
</Defs>
