<Defs>
  <ThoughtDef>
    <defName>Entad_Thought_Contentment</defName>
    <durationDays>1</durationDays>
    <stackLimit>5</stackLimit>
    <stages>
      <li>
        <label>entad contentment</label>
        <description>Something about this object makes me feel at ease.</description>
        <baseMoodEffect>4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <EntadFramework.EntadModifierDef>
    <defName>Entad_Contentment</defName>
    <label>contentment</label>
    <description>Whoever holds or uses this item feels strangely at ease.</description>
    <categories>
      <li>Weapon</li>
      <li>Apparel</li>
      <li>Furniture</li>
    </categories>
    <rarity>Common</rarity>
    <thought>Entad_Thought_Contentment</thought>
    <thoughtHours>
      <min>6</min>
      <max>24</max>
    </thoughtHours>
  </EntadFramework.EntadModifierDef>

  <EntadFramework.EntadModifierDef>
    <defName>Entad_RandomGoodMood</defName>
    <label>fickle cheer</label>
    <description>Whoever holds or uses this item is overcome by a random good feeling.</description>
    <categories>
      <li>Weapon</li>
      <li>Apparel</li>
      <li>Furniture</li>
    </categories>
    <rarity>Uncommon</rarity>
    <thoughtMoodRange>
      <min>2</min>
      <max>8</max>
    </thoughtMoodRange>
    <thoughtHours>
      <min>4</min>
      <max>12</max>
    </thoughtHours>
  </EntadFramework.EntadModifierDef>
</Defs>
