<?xml version="1.0" encoding="utf-8"?>
<loadFolders>
  <!-- Defs, Patches, Languages and Textures are shared from the root. Each version loads only its own
       Assemblies: the 1.6 and 1.7 DLLs are compiled against different game assemblies.
       Mods/AbilityAI holds the integration with the optional Ability AI mod (its rules for entad abilities, and the
       compat assembly that registers Entad's hook), loaded only when Ability AI is active. Mods/DubsBadHygiene holds
       the plumbing traits and their compat assembly, loaded only when Dubs Bad Hygiene is active. -->
  <v1.6>
    <li>/</li>
    <li>1.6</li>
    <li IfModActive="saintwacko.AbilityAI">Mods/AbilityAI</li>
    <li IfModActive="saintwacko.AbilityAI">Mods/AbilityAI/1.6</li>
    <li IfModActive="Dubwise.DubsBadHygiene">Mods/DubsBadHygiene</li>
    <li IfModActive="Dubwise.DubsBadHygiene">Mods/DubsBadHygiene/1.6</li>
  </v1.6>
  <v1.7>
    <li>/</li>
    <li>1.7</li>
    <li IfModActive="saintwacko.AbilityAI">Mods/AbilityAI</li>
    <li IfModActive="saintwacko.AbilityAI">Mods/AbilityAI/1.7</li>
    <li IfModActive="Dubwise.DubsBadHygiene">Mods/DubsBadHygiene</li>
    <li IfModActive="Dubwise.DubsBadHygiene">Mods/DubsBadHygiene/1.7</li>
  </v1.7>
</loadFolders>
