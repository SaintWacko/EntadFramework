<Project Sdk="Microsoft.NET.Sdk">
    <!--
        RimWorld 1.6 build of Entad's Combat Extended compat assembly. The C# lives in Mods/CombatExtended/Source, ready
        to share with a 1.7 project once CE supports 1.7. Output goes to Mods/CombatExtended/1.6/Assemblies, which
        LoadFolders.xml loads only on 1.6 and only when Combat Extended (CETeam.CombatExtended) is active.

        CE is not on NuGet, so CombatExtended.dll is read from its install (the Steam Workshop folder by default;
        override with /p:CEDir=...). Neither it nor EntadFramework.dll is copied to the output.
    -->
    <PropertyGroup>
        <OutputType>Library</OutputType>
        <TargetFramework>net472</TargetFramework>
        <RootNamespace>EntadFramework.CECompat</RootNamespace>
        <AssemblyName>EntadFramework.CECompat</AssemblyName>
        <LangVersion>latest</LangVersion>
        <Deterministic>true</Deterministic>
        <OutputPath>..\Assemblies\</OutputPath>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
        <DefineConstants>$(DefineConstants);RW16</DefineConstants>
        <Version>1.0.0</Version>
        <AssemblyVersion>1.0.0.0</AssemblyVersion>
        <FileVersion>1.0.0.0</FileVersion>
        <Product>Entad Framework</Product>
        <Authors>SaintWacko</Authors>
    </PropertyGroup>

    <Import Project="..\..\Source\CEDir.props" />

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <Optimize>true</Optimize>
        <DebugType>none</DebugType>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
        <Optimize>false</Optimize>
        <DebugType>portable</DebugType>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="..\..\Source\*.cs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4871">
            <PrivateAssets>all</PrivateAssets>
            <ExcludeAssets>runtime</ExcludeAssets>
        </PackageReference>
        <!-- Compile-only, as in the main project: the Harmony mod supplies the runtime DLL -->
        <PackageReference Include="Lib.Harmony" Version="2.4.1">
            <PrivateAssets>all</PrivateAssets>
            <ExcludeAssets>runtime</ExcludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\..\1.6\Source\EntadFramework.csproj">
            <Private>false</Private>
        </ProjectReference>
        <Reference Include="CombatExtended">
            <HintPath>$(CEDir)Assemblies/CombatExtended.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>
</Project>
