<Project Sdk="Microsoft.NET.Sdk">
    <!--
        RimWorld 1.7 build of Entad's Dubs Bad Hygiene compat assembly. Same shared C# as 1.6
        (Mods/DubsBadHygiene/Source), compiled with RW17 defined. Output goes to Mods/DubsBadHygiene/1.7/Assemblies,
        which LoadFolders.xml loads only on 1.7 and only when Dubs Bad Hygiene (Dubwise.DubsBadHygiene) is active.

        Game references as in the main 1.7 project: the Krafs.Rimworld.Ref 1.7 package targets net10.0 only, so it is
        downloaded as-is and its DLLs referenced by path. DBH's 1.7 DLLs come from its install (DBHDir.props).
    -->
    <PropertyGroup>
        <OutputType>Library</OutputType>
        <TargetFramework>net472</TargetFramework>
        <RootNamespace>EntadFramework.HygieneCompat</RootNamespace>
        <AssemblyName>EntadFramework.HygieneCompat</AssemblyName>
        <LangVersion>latest</LangVersion>
        <Deterministic>true</Deterministic>
        <OutputPath>..\Assemblies\</OutputPath>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
        <DefineConstants>$(DefineConstants);RW17</DefineConstants>
        <Version>1.0.0</Version>
        <AssemblyVersion>1.0.0.0</AssemblyVersion>
        <FileVersion>1.0.0.0</FileVersion>
        <Product>Entad Framework</Product>
        <Authors>SaintWacko</Authors>
        <!-- Keep in step with the main 1.7 project -->
        <RW17RefVersion>1.7.4979-alpha</RW17RefVersion>
        <RW17Ref>$(NuGetPackageRoot)krafs.rimworld.ref/$(RW17RefVersion)/ref/net10.0/</RW17Ref>
    </PropertyGroup>

    <Import Project="..\..\Source\DBHDir.props" />

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <Optimize>true</Optimize>
        <DebugType>none</DebugType>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
        <Optimize>false</Optimize>
        <DebugType>portable</DebugType>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="..\..\Source\*.cs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
        <PackageDownload Include="Krafs.Rimworld.Ref" Version="[$(RW17RefVersion)]" />
        <!-- Compile-only, as in the main project: the Harmony mod supplies the runtime DLL -->
        <PackageReference Include="Lib.Harmony" Version="2.4.1">
            <PrivateAssets>all</PrivateAssets>
            <ExcludeAssets>runtime</ExcludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <Reference Include="Assembly-CSharp">
            <HintPath>$(RW17Ref)Assembly-CSharp.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine">
            <HintPath>$(RW17Ref)UnityStubs.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Waylith">
            <HintPath>$(RW17Ref)Waylith.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <ProjectReference Include="..\..\..\..\1.7\Source\EntadFramework.csproj">
            <Private>false</Private>
        </ProjectReference>
        <Reference Include="BadHygiene">
            <HintPath>$(DBHDir)1.7/Assemblies/BadHygiene.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="0DubCore">
            <HintPath>$(DBHDir)1.7/Assemblies/0DubCore.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>
</Project>
