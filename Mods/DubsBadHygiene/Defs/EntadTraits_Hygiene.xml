<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Dubs Bad Hygiene traits (Mods/DubsBadHygiene/Source/EntadHygiene.cs), loaded only while DBH is active. Pure and
       Bottomless Pit are customEffects keys the compat assembly registers; the rest are stats on the building. Effects
       on the plumbing network follow the building, not the pipes (pipes never become entads). -->

  <!-- Water towers, wells and pumps: the network counts as having a working water filter, so its towers turn treated
       and polluted wells stop contaminating them -->
  <EntadFramework.EntadTraitDef>
    <defName>Entad_Pure</defName>
    <label>Pure</label>
    <description>Water that passes near it comes out clear and cold, whatever went in.</description>
    <categories><li>Furniture</li></categories>
    <rarity>Rare</rarity>
    <exclusiveWith><li>Entad_Fouling</li></exclusiveWith>
    <customEffects><li>DBH_Pure</li></customEffects>
    <customCardLines><li>Water on its plumbing network is treated, as if filtered</li></customCardLines>
  </EntadFramework.EntadTraitDef>

  <!-- Wells (ground capacity) and pumping stations (pumping capacity) -->
  <EntadFramework.EntadTraitDef>
    <defName>Entad_Wellspring</defName>
    <label>Wellspring</label>
    <description>Water finds its way to it from further than any map says it should.</description>
    <categories><li>Furniture</li></categories>
    <rarity>Uncommon</rarity>
    <scalesWithRarity>true</scalesWithRarity>
    <statFactors>
      <li><stat>Entad_WaterCapacityFactor</stat><min>1.3</min><max>1.5</max></li>
    </statFactors>
  </EntadFramework.EntadTraitDef>

  <!-- Septic tanks and sewage treatment -->
  <EntadFramework.EntadTraitDef>
    <defName>Entad_Cesspit</defName>
    <label>Cesspit</label>
    <description>Whatever goes into it is gone sooner than it has any right to be.</description>
    <categories><li>Furniture</li></categories>
    <rarity>Uncommon</rarity>
    <scalesWithRarity>true</scalesWithRarity>
    <statFactors>
      <li><stat>Entad_SewageTreatmentFactor</stat><min>1.5</min><max>2</max></li>
    </statFactors>
  </EntadFramework.EntadTraitDef>

  <!-- Flush toilets and latrines (spacer toilets make no sewage): flushes push no sewage, so it never backs up, even
       with no septic tank on its network. Water use is unchanged. -->
  <EntadFramework.EntadTraitDef>
    <defName>Entad_BottomlessPit</defName>
    <label>Bottomless Pit</label>
    <description>Nobody has heard anything land at the bottom of it.</description>
    <categories><li>Furniture</li></categories>
    <rarity>Rare</rarity>
    <customEffects><li>DBH_BottomlessPit</li></customEffects>
    <customCardLines><li>Flushing makes no sewage, so it never backs up</li></customCardLines>
  </EntadFramework.EntadTraitDef>

  <!-- Drawback: a working water filter on the network stops it -->
  <EntadFramework.EntadTraitDef>
    <defName>Entad_Fouling</defName>
    <label>Fouling</label>
    <description>Water that touches it tastes of old iron and something worse.</description>
    <categories><li>Furniture</li></categories>
    <rarity>Common</rarity>
    <points>-1</points>
    <statOffsets>
      <li><stat>Entad_WaterFoulingChance</stat><min>0.25</min><max>0.5</max></li>
    </statOffsets>
  </EntadFramework.EntadTraitDef>

  <!-- Drawback, water towers only: more pumping makes up for it -->
  <EntadFramework.EntadTraitDef>
    <defName>Entad_Evaporative</defName>
    <label>Evaporative</label>
    <description>The tank is always a little emptier than the last time anyone looked.</description>
    <categories><li>Furniture</li></categories>
    <rarity>Common</rarity>
    <points>-1</points>
    <statOffsets>
      <li><stat>Entad_WaterLossPerDay</stat><min>0.1</min><max>0.2</max></li>
    </statOffsets>
  </EntadFramework.EntadTraitDef>
</Defs>
