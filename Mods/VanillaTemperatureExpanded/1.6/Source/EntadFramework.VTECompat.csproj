<Project Sdk="Microsoft.NET.Sdk">
    <!--
        RimWorld 1.6 build of Entad's Vanilla Temperature Expanded compat assembly. The C# is shared with 1.7:
        Mods/VanillaTemperatureExpanded/Source. Output goes to Mods/VanillaTemperatureExpanded/1.6/Assemblies, which LoadFolders.xml loads only
        on 1.6 and only when Vanilla Temperature Expanded (VanillaExpanded.Temperature) is active.

        VTE is not on NuGet, so ProxyHeat.dll is read from its install (the Steam Workshop folder by default; override
        with /p:VTEDir=... pointing at the folder that holds 1.6/). Neither it nor EntadFramework.dll is copied to the
        output. Lib.Harmony is referenced for AccessTools only; the module patches nothing.
    -->
    <PropertyGroup>
        <OutputType>Library</OutputType>
        <!-- net48 because ProxyHeat.dll is built for it; RimWorld's Mono loads either -->
        <TargetFramework>net48</TargetFramework>
        <RootNamespace>EntadFramework.VTECompat</RootNamespace>
        <AssemblyName>EntadFramework.VTECompat</AssemblyName>
        <LangVersion>latest</LangVersion>
        <Deterministic>true</Deterministic>
        <OutputPath>..\Assemblies\</OutputPath>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
        <DefineConstants>$(DefineConstants);RW16</DefineConstants>
        <Version>1.0.0</Version>
        <AssemblyVersion>1.0.0.0</AssemblyVersion>
        <FileVersion>1.0.0.0</FileVersion>
        <Product>Entad Framework</Product>
        <Authors>SaintWacko</Authors>
    </PropertyGroup>

    <Import Project="..\..\Source\VTEDir.props" />

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <Optimize>true</Optimize>
        <DebugType>none</DebugType>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
        <Optimize>false</Optimize>
        <DebugType>portable</DebugType>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="..\..\Source\*.cs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4871">
            <PrivateAssets>all</PrivateAssets>
            <ExcludeAssets>runtime</ExcludeAssets>
        </PackageReference>
        <!-- Compile-only, as in the main project: the Harmony mod supplies the runtime DLL -->
        <PackageReference Include="Lib.Harmony" Version="2.4.1">
            <PrivateAssets>all</PrivateAssets>
            <ExcludeAssets>runtime</ExcludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\..\1.6\Source\EntadFramework.csproj">
            <Private>false</Private>
        </ProjectReference>
        <Reference Include="ProxyHeat">
            <HintPath>$(VTE16Assemblies)ProxyHeat.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>
</Project>
