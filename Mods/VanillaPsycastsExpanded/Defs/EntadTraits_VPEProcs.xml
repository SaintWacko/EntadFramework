<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Vanilla Psycasts Expanded psycasts cast by triggers (EntadProcs.cs in the main assembly, CanProc/Proc in
       EntadVEFAbilities.cs): at once, no psyfocus, heat or psylink, ignoring the psycast's range and line of sight. The
       holder counts as 100% psychic sensitivity, as for the psycast traits. Royalty's own psycasts are cast by vanilla
       ability (EntadTraits_Procs.xml): VPE needs Royalty, so those cover VPE's copies of them. -->

  <EntadFramework.EntadTraitDef>
    <defName>Entad_VPE_Proc_Overshield</defName>
    <label>Aegis</label>
    <description>Strike its owner and the air around them hardens.</description>
    <categories><li>Apparel</li></categories>
    <rarity>Rare</rarity>
    <scalesWithRarity>true</scalesWithRarity>
    <triggers>
      <li>
        <on>TakeDamage</on>
        <fromEnemy>true</fromEnemy>
        <chance>0.3</chance>
        <cooldownSeconds>45~60</cooldownSeconds>
        <rarityScales>Cooldown</rarityScales>
        <casts>
          <li><externalAbility>VPE_Overshield</externalAbility><target>Self</target></li>
        </casts>
      </li>
    </triggers>
  </EntadFramework.EntadTraitDef>

  <!-- Ranged damage from 8+ tiles: the ring of ice is 5 to 5.9 tiles out from the attacker, and a nearer holder
       would be walled in with it -->
  <EntadFramework.EntadTraitDef>
    <defName>Entad_VPE_Proc_IceWall</defName>
    <label>Frostward</label>
    <description>Those who shoot at its owner sometimes find themselves walled in by ice.</description>
    <categories><li>Apparel</li></categories>
    <rarity>Epic</rarity>
    <scalesWithRarity>true</scalesWithRarity>
    <triggers>
      <li>
        <on>TakeDamage</on>
        <attack>Ranged</attack>
        <fromEnemy>true</fromEnemy>
        <minDistance>8</minDistance>
        <chance>0.2</chance>
        <cooldownSeconds>60~90</cooldownSeconds>
        <rarityScales>Cooldown</rarityScales>
        <casts>
          <li><externalAbility>VPE_IceWall</externalAbility><target>Attacker</target></li>
        </casts>
      </li>
    </triggers>
    <!-- Mist sinking off the wearer with glints of ice over it: the strongest of the frost looks, for the Epic one -->
    <visuals>
      <li Class="EntadFramework.EntadVisual_WeaponGlow">
        <color>(0.65, 0.88, 1, 0.24)</color>
        <pulseSpeed>0.3</pulseSpeed>
        <flicker>0.05</flicker>
        <tint>1</tint>
      </li>
      <li Class="EntadFramework.EntadVisual_WornFlecks">
        <fleck>Entad_Fleck_FrostMistWorn</fleck>
        <perSecond>4.5</perSecond>
        <scale>0.5~0.75</scale>
        <speed>0.15~0.3</speed>
        <angle>150~210</angle>
        <rotationRate>-15~15</rotationRate>
        <x>-0.25~0.25</x>
      </li>
      <li Class="EntadFramework.EntadVisual_WornFlecks">
        <fleck>Entad_Fleck_Glint</fleck>
        <color>(0.4, 0.68, 1)</color>
        <perSecond>1.5</perSecond>
        <scale>0.15~0.25</scale>
        <speed>0~0.05</speed>
        <z>-0.2~0.2</z>
      </li>
    </visuals>
  </EntadFramework.EntadTraitDef>

  <!-- A decoy where the holder stood, then a chaos skip away. Royalty's chaos skip, since VPE's draws its skip
       flashes during the casting job a trigger doesn't run. The landing spot is random, near enemies or not, and
       the skip stuns for 1-2 seconds on arrival, as the psycast does. The decoy is optional: VPE won't put one on a
       building's cell (a conduit, a door), and that mustn't stop the skip. -->
  <EntadFramework.EntadTraitDef>
    <defName>Entad_VPE_Proc_Escape</defName>
    <label>Escape Artist</label>
    <description>Its owners have a way of not being there when the killing blow lands.</description>
    <categories><li>Apparel</li></categories>
    <rarity>Legendary</rarity>
    <triggers>
      <li>
        <on>TakeDamage</on>
        <fromEnemy>true</fromEnemy>
        <healthBelow>0.5</healthBelow>
        <cooldownHours>96</cooldownHours>
        <casts>
          <li><externalAbility>VPE_Decoy</externalAbility><target>Origin</target><optional>true</optional></li>
          <li><ability>ChaosSkip</ability><target>Self</target></li>
        </casts>
      </li>
    </triggers>
  </EntadFramework.EntadTraitDef>

  <!-- Both effects last a day and refresh rather than stack: the wielder keeps the buff through a fight, and each
       pawn it lands on carries the debuff -->
  <EntadFramework.EntadTraitDef>
    <defName>Entad_VPE_Proc_StealVitality</defName>
    <label>Siphoning</label>
    <description>A cut from it leaves the victim pale and its wielder flushed.</description>
    <categories><li>WeaponMelee</li></categories>
    <rarity>Rare</rarity>
    <scalesWithRarity>true</scalesWithRarity>
    <triggers>
      <li>
        <on>Hit</on>
        <attack>Melee</attack>
        <victims>Hostile</victims>
        <chance>0.06~0.08</chance>
        <rarityScales>Chance</rarityScales>
        <rateNormalized>1</rateNormalized>
        <casts>
          <li><externalAbility>VPE_StealVitality</externalAbility><target>Victim</target></li>
        </casts>
      </li>
    </triggers>
  </EntadFramework.EntadTraitDef>

  <!-- Up to 3 mechanoids or turrets within 2.9 tiles of the enemy mech hit go haywire for 40 seconds, whoever owns
       them. Haywire only targets cells, so CanProc aims it at the mech's cell. -->
  <EntadFramework.EntadTraitDef>
    <defName>Entad_VPE_Proc_Haywire</defName>
    <label>Subverting</label>
    <description>Machines it strikes sometimes forget whose side they are on.</description>
    <categories><li>Weapon</li></categories>
    <rarity>Epic</rarity>
    <scalesWithRarity>true</scalesWithRarity>
    <triggers>
      <li>
        <on>Hit</on>
        <victims>HostileMechanoid</victims>
        <chance>0.04~0.06</chance>
        <rarityScales>Chance</rarityScales>
        <rateNormalized>1</rateNormalized>
        <adaptSeconds>60</adaptSeconds>
        <adaptFactor>0.5</adaptFactor>
        <casts>
          <li><externalAbility>VPE_Haywire</externalAbility><target>Victim</target></li>
        </casts>
      </li>
    </triggers>
  </EntadFramework.EntadTraitDef>

  <!-- A 7 tile fire blast where the enemy died, which spares nobody: 10+ tiles keeps the holder out of it, not
       allies fighting next to the victim -->
  <EntadFramework.EntadTraitDef>
    <defName>Entad_VPE_Proc_Explosion</defName>
    <label>Detonating</label>
    <description>Now and then, what it kills does not stay quiet.</description>
    <categories><li>WeaponRanged</li></categories>
    <rarity>Epic</rarity>
    <scalesWithRarity>true</scalesWithRarity>
    <triggers>
      <li>
        <on>Kill</on>
        <victims>Hostile</victims>
        <minDistance>10</minDistance>
        <chance>0.15~0.2</chance>
        <rarityScales>Chance</rarityScales>
        <casts>
          <li><externalAbility>VPE_Explosion</externalAbility><target>VictimCell</target></li>
        </casts>
      </li>
    </triggers>
  </EntadFramework.EntadTraitDef>

  <!-- A melee hit that downs or kills a standing enemy: skips to the nearest enemy in sight anywhere on the map,
       strikes twice, and keeps going for as long as each jump kills (VPE's own chain, no range limit, by choice) -->
  <EntadFramework.EntadTraitDef>
    <defName>Entad_VPE_Proc_Killskip</defName>
    <label>Relentless</label>
    <description>When it takes a life, it is already looking for the next.</description>
    <categories><li>WeaponMelee</li></categories>
    <rarity>Legendary</rarity>
    <triggers>
      <li>
        <on>Hit</on>
        <attack>Melee</attack>
        <victims>Hostile</victims>
        <finishing>true</finishing>
        <chance>0.3</chance>
        <cooldownHours>48</cooldownHours>
        <casts>
          <li><externalAbility>VPE_Killskip</externalAbility><target>NearestEnemy</target></li>
        </casts>
      </li>
    </triggers>
  </EntadFramework.EntadTraitDef>

  <EntadFramework.EntadTraitDef>
    <defName>Entad_VPE_Proc_IceSpike</defName>
    <label>Rimeguard</label>
    <description>Hurt its owner, and a shard of ice answers.</description>
    <categories><li>Apparel</li></categories>
    <rarity>Uncommon</rarity>
    <scalesWithRarity>true</scalesWithRarity>
    <triggers>
      <li>
        <on>TakeDamage</on>
        <fromEnemy>true</fromEnemy>
        <chance>0.25</chance>
        <cooldownSeconds>20~30</cooldownSeconds>
        <rarityScales>Cooldown</rarityScales>
        <casts>
          <li><externalAbility>VPE_IceSpike</externalAbility><target>Attacker</target></li>
        </casts>
      </li>
    </triggers>
    <!-- Glints of rime over the wearer, without Frostward's mist -->
    <visuals>
      <li Class="EntadFramework.EntadVisual_WeaponGlow">
        <color>(0.65, 0.88, 1, 0.18)</color>
        <pulseSpeed>0.3</pulseSpeed>
        <flicker>0.05</flicker>
        <tint>1.2</tint>
      </li>
      <li Class="EntadFramework.EntadVisual_WornFlecks">
        <fleck>Entad_Fleck_Glint</fleck>
        <color>(0.4, 0.68, 1)</color>
        <perSecond>1.5</perSecond>
        <scale>0.12~0.2</scale>
        <speed>0~0.05</speed>
        <z>-0.2~0.2</z>
      </li>
    </visuals>
  </EntadFramework.EntadTraitDef>

  <!-- 20 seconds of a shield that sets melee attackers alight -->
  <EntadFramework.EntadTraitDef>
    <defName>Entad_VPE_Proc_FireShield</defName>
    <label>Smoldering</label>
    <description>Those who get close enough to strike its owner tend to leave singed.</description>
    <categories><li>Apparel</li></categories>
    <rarity>Uncommon</rarity>
    <scalesWithRarity>true</scalesWithRarity>
    <triggers>
      <li>
        <on>TakeDamage</on>
        <attack>Melee</attack>
        <fromEnemy>true</fromEnemy>
        <chance>0.3</chance>
        <cooldownSeconds>45~60</cooldownSeconds>
        <rarityScales>Cooldown</rarityScales>
        <casts>
          <li><externalAbility>VPE_FireShield</externalAbility><target>Self</target></li>
        </casts>
      </li>
    </triggers>
    <!-- Thin smoke and the odd ember rising off the wearer, as if something under the clothes were smouldering -->
    <visuals>
      <li Class="EntadFramework.EntadVisual_WeaponGlow">
        <color>(1, 0.4, 0.1, 0.18)</color>
        <pulseSpeed>0.5</pulseSpeed>
        <flicker>0.3</flicker>
        <tint>1.2</tint>
      </li>
      <li Class="EntadFramework.EntadVisual_WornFlecks">
        <fleck>Entad_Fleck_SmokeWisp</fleck>
        <perSecond>2.5</perSecond>
        <scale>0.4~0.6</scale>
        <speed>0.25~0.4</speed>
        <angle>-20~20</angle>
        <rotationRate>-10~10</rotationRate>
        <z>0~0.2</z>
      </li>
      <li Class="EntadFramework.EntadVisual_WornFlecks">
        <fleck>Entad_Fleck_Ember</fleck>
        <perSecond>1.5</perSecond>
        <scale>0.1~0.16</scale>
        <speed>0.3~0.6</speed>
        <angle>-30~30</angle>
      </li>
    </visuals>
  </EntadFramework.EntadTraitDef>

  <!-- 25 burn damage to whatever stands on the target's cell, VPE's 6 tile EMP blast (shield belts, turrets and mechs,
       the holder's side included) and the lightning strike's own small fire blast. 9+ tiles keeps the holder out of
       the EMP; only under open sky, since the bolt comes down from it. The blast doesn't grow with the weapon's
       damage: VPE's numbers are fixed. -->
  <EntadFramework.EntadTraitDef>
    <defName>Entad_VPE_Proc_Thunderbolt</defName>
    <label>Stormcalling</label>
    <description>Now and then the sky answers its shots.</description>
    <categories><li>WeaponRanged</li></categories>
    <rarity>Epic</rarity>
    <scalesWithRarity>true</scalesWithRarity>
    <triggers>
      <li>
        <on>Hit</on>
        <attack>Ranged</attack>
        <victims>Hostile</victims>
        <minDistance>9</minDistance>
        <chance>0.04~0.06</chance>
        <rarityScales>Chance</rarityScales>
        <rateNormalized>1</rateNormalized>
        <casts>
          <li><externalAbility>VPE_Thunderbolt</externalAbility><target>Victim</target><unroofed>true</unroofed></li>
        </casts>
      </li>
    </triggers>
  </EntadFramework.EntadTraitDef>

  <!-- Everyone within 3 tiles of the target, allies and animals too, but never the holder, is frozen for 6 seconds
       (less above freezing: 4.8 at 20C) and chilled towards hypothermia. Repeats on the same target within 30 seconds
       freeze it for half as long each time; others caught in the area don't adapt. -->
  <EntadFramework.EntadTraitDef>
    <defName>Entad_VPE_Proc_SnapFreeze</defName>
    <label>Snapfrost</label>
    <description>What it strikes is sometimes left standing in a block of ice, along with anyone close by.</description>
    <categories><li>Weapon</li></categories>
    <rarity>Epic</rarity>
    <scalesWithRarity>true</scalesWithRarity>
    <triggers>
      <li>
        <on>Hit</on>
        <victims>Hostile</victims>
        <chance>0.03~0.05</chance>
        <rarityScales>Chance</rarityScales>
        <rateNormalized>1</rateNormalized>
        <adaptSeconds>30</adaptSeconds>
        <adaptFactor>0.5</adaptFactor>
        <casts>
          <li><externalAbility>VPE_SnapFreeze</externalAbility><target>Victim</target></li>
        </casts>
      </li>
    </triggers>
  </EntadFramework.EntadTraitDef>

  <!-- Brambles on every fertile cell within 6 tiles of the target without a building or a tree, replacing whatever
       grew there (crops too), gone after an hour instead of the psycast's 12. They roughly halve a walker's speed and
       give no cover: a melee raid shot at on its way in wades through them. 8+ tiles keeps the field off the shooter.
       A target on a building's cell (a door) can't be cast at. The 30 second cooldown is there because a second field
       on the first changes nothing and spawns some hundred things each time. -->
  <EntadFramework.EntadTraitDef>
    <defName>Entad_VPE_Proc_BrambleMaze</defName>
    <label>Thornwake</label>
    <description>Where its shots land, thorns spring up from the ground.</description>
    <categories><li>WeaponRanged</li></categories>
    <rarity>Uncommon</rarity>
    <scalesWithRarity>true</scalesWithRarity>
    <triggers>
      <li>
        <on>Hit</on>
        <attack>Ranged</attack>
        <victims>Hostile</victims>
        <minDistance>8</minDistance>
        <chance>0.08~0.12</chance>
        <rarityScales>Chance</rarityScales>
        <rateNormalized>1</rateNormalized>
        <cooldownSeconds>30</cooldownSeconds>
        <casts>
          <li><externalAbility>VPE_BrambleMaze</externalAbility><target>Victim</target></li>
        </casts>
      </li>
    </triggers>
    <modExtensions>
      <li Class="EntadFramework.VPECompat.EntadVEFTraitExtension">
        <durationTicks>2500</durationTicks>
      </li>
    </modExtensions>
  </EntadFramework.EntadTraitDef>

  <!-- Stops bleeding for 2.4 hours, enough for a rescuer to get there -->
  <EntadFramework.EntadTraitDef>
    <defName>Entad_VPE_Proc_Stabilize</defName>
    <label>Lifeline</label>
    <description>Its owners have a habit of not bleeding out.</description>
    <categories><li>Apparel</li></categories>
    <rarity>Rare</rarity>
    <scalesWithRarity>true</scalesWithRarity>
    <triggers>
      <li>
        <on>Downed</on>
        <cooldownHours>20~28</cooldownHours>
        <rarityScales>Cooldown</rarityScales>
        <casts>
          <li><externalAbility>VPE_Stabilize</externalAbility><target>Self</target></li>
        </casts>
      </li>
    </triggers>
  </EntadFramework.EntadTraitDef>
</Defs>
