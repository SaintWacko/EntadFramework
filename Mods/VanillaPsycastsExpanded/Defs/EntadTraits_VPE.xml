<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Vanilla Psycasts Expanded psycasts as gear abilities (Mods/VanillaPsycastsExpanded/Source/EntadVEFAbilities.cs),
       loaded only while VPE is active. Anyone holding the item can cast them: no psylink, psyfocus or neural heat, with
       the trait's charges and cooldown instead (a charge comes back after each cooldown). Where VPE scales an effect by
       the caster's psychic sensitivity (range, duration, Word of Animals' odds, Mend's repair), the holder counts as
       100%, or as the casterSensitivity of an EntadFramework.VPECompat.EntadVEFTraitExtension on the trait. A target's
       own sensitivity still counts, and a psychically deaf pawn can't be targeted by the psychic ones.
       Only psycasts that need a deliberate choice of target are here; the reactive ones are planned as triggered
       traits. Rarity follows the psycast's level: 1-2 Uncommon, 3 Rare, 4 Epic, 5 Legendary. -->

  <!-- Skipmaster -->
  <EntadFramework.EntadTraitDef>
    <defName>Entad_VPE_Skip</defName>
    <label>Skip</label>
    <description>Things it points at have a habit of being somewhere else a moment later.</description>
    <categories><li>Weapon</li><li>Apparel</li></categories>
    <rarity>Uncommon</rarity>
    <externalAbilities><li>VPE_Skip</li></externalAbilities>
    <abilityCharges>2</abilityCharges>
    <abilityCooldownTicks>60000</abilityCooldownTicks>
  </EntadFramework.EntadTraitDef>

  <EntadFramework.EntadTraitDef>
    <defName>Entad_VPE_Farskip</defName>
    <label>Farskip</label>
    <description>Whoever carries it is never quite as far from home as the map says.</description>
    <categories><li>Weapon</li><li>Apparel</li></categories>
    <rarity>Legendary</rarity>
    <externalAbilities><li>VPE_Farskip</li></externalAbilities>
    <abilityCharges>1</abilityCharges>
    <abilityCooldownTicks>180000</abilityCooldownTicks>
  </EntadFramework.EntadTraitDef>

