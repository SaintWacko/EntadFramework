  <!-- Archon: VPE's own mind break is a level 4 psycast with a heavy psyfocus cost. As a gear ability it recruits a
       pawn per cast, so it gets a far longer cooldown than its level alone would give. -->
  <EntadFramework.EntadTraitDef>
    <defName>Entad_VPE_MindBreak</defName>
    <label>Mind Break</label>
    <description>Some who meet its bearer's eye forget who they used to follow.</description>
    <categories><li>Weapon</li><li>Apparel</li></categories>
    <rarity>Epic</rarity>
    <externalAbilities><li>VPE_MindBreak</li></externalAbilities>
    <abilityCharges>1</abilityCharges>
    <abilityCooldownTicks>600000</abilityCooldownTicks>
  </EntadFramework.EntadTraitDef>

  <!-- Technomancer: VPE's Mend repairs (sensitivity - 1) x 100 hit points, nothing at 100%, so this one casts at 150%:
       50 hit points shared over a pawn's damaged gear, an item or a building, or 50 points of a mech's injuries -->
  <EntadFramework.EntadTraitDef>
    <defName>Entad_VPE_Mend</defName>
    <label>Mend</label>
    <description>Scratches fade from whatever it rests against, and torn seams knit themselves shut overnight.</description>
    <categories><li>Weapon</li><li>Apparel</li></categories>
    <rarity>Uncommon</rarity>
    <externalAbilities><li>VPE_Mend</li></externalAbilities>
    <abilityCharges>2</abilityCharges>
    <abilityCooldownTicks>60000</abilityCooldownTicks>
    <modExtensions>
      <li Class="EntadFramework.VPECompat.EntadVEFTraitExtension">
        <casterSensitivity>1.5</casterSensitivity>
      </li>
    </modExtensions>
  </EntadFramework.EntadTraitDef>

  <!-- Chronopath: VPE ages the caster a year with each of these, and the copies keep that -->
