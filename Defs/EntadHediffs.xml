<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Parent for hediffs an entad gives: equipped, trigger, furniture, bond and aura hediffs. Other mods may use it.
       A healer mech serum would remove one while the item still grants it, and the scenario editor has no use for
       them, so both are off. Set isBad true for a harmful one; a child's hediffClass replaces this one. -->
  <HediffDef Name="EntadHediffBase" Abstract="True">
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <scenarioCanAdd>false</scenarioCanAdd>
  </HediffDef>

  <!-- Parent for aura hediffs (EntadAuras.cs). Each scan renews the hediff, and it fades 400 ticks after the last
       one: out of range, out of sight, or the source no longer active. A child that adds its own comps gets them
       beside this one; list entries are appended, not replaced. -->
  <HediffDef Name="EntadAuraHediffBase" ParentName="EntadHediffBase" Abstract="True">
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>400</disappearsAfterTicks>
        <showRemainingTime>false</showRemainingTime>
      </li>
    </comps>
  </HediffDef>

  <!-- Marks a trade caravan member who identifies entads for silver (EntadAppraisal.cs) -->
  <HediffDef ParentName="EntadHediffBase">
    <defName>Entad_Appraiser</defName>
    <label>entad appraiser</label>
    <description>This person can identify entads. For a fee, they reveal every hidden trait of an item, but they can only examine a few items each day.</description>
    <hediffClass>EntadFramework.Hediff_EntadAppraiser</hediffClass>
    <defaultLabelColor>(0.85, 0.75, 1)</defaultLabelColor>
  </HediffDef>

  <!-- Given while an entad with the Clarity trait is worn or wielded (equippedHediffs) -->
  <HediffDef ParentName="EntadHediffBase">
    <defName>Entad_Hediff_Clarity</defName>
    <label>entad clarity</label>
    <description>An entad this person carries keeps their thoughts unusually clear. They think a little faster and pick up new skills more easily.</description>
    <defaultLabelColor>(0.6, 0.85, 1)</defaultLabelColor>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>0.05</offset>
          </li>
        </capMods>
        <statOffsets>
          <GlobalLearningFactor>0.1</GlobalLearningFactor>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <EntadFramework.EntadTraitDef>
    <defName>Entad_Clarity</defName>
    <label>Clarity</label>
    <description>Whoever wears or wields this item thinks more clearly while they have it.</description>
    <categories>
      <li>Weapon</li>
      <li>Apparel</li>
    </categories>
    <rarity>Uncommon</rarity>
    <equippedHediffs>
      <li>Entad_Hediff_Clarity</li>
    </equippedHediffs>
  </EntadFramework.EntadTraitDef>
</Defs>
