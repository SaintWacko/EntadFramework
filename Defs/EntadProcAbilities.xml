<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Abilities for triggers to cast (Source/EntadProcEffects.cs, traits in EntadTraits_Procs.xml). No DLC needed. A
       trigger casts them at once, ignoring range and line of sight, so the verbs here only say what they can
       target. Each effect refuses a target it would do nothing to (no second enemy for a ricochet, no weapon to knock
       away), and the trigger then keeps its cooldown. They are never granted as gizmos, but another mod can. -->

  <AbilityDef ParentName="EntadAbilityBase">
    <defName>Entad_Ricochet</defName>
    <label>ricochet</label>
    <description>A second shot from the user's weapon flies from where the first one landed to the nearest other enemy within 8 tiles in sight of that spot. It deals the weapon's own damage and flies past anyone else in the way. An explosive shot still bursts where it lands.</description>
    <iconPath>UI/Abilities/Entad/Ricochet</iconPath>
    <hostile>true</hostile>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>8</range>
      <targetParams>
        <canTargetLocations>true</canTargetLocations>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="EntadFramework.CompProperties_AbilityEntadRicochet">
        <range>8</range>
      </li>
    </comps>
  </AbilityDef>

  <AbilityDef ParentName="EntadAbilityBase">
    <defName>Entad_Disarm</defName>
    <label>disarm</label>
    <description>Knocks a person's weapon out of their hands, up to 3 tiles away. Weapons that can't be dropped, like a mechanoid's or a turret's, are left alone.</description>
    <iconPath>UI/Abilities/Entad/Disarm</iconPath>
    <hostile>true</hostile>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>1.5</range>
      <targetParams>
        <canTargetPawns>true</canTargetPawns>
        <canTargetBuildings>false</canTargetBuildings>
        <canTargetAnimals>false</canTargetAnimals>
        <canTargetMechs>false</canTargetMechs>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="EntadFramework.CompProperties_AbilityEntadDisarm">
        <throwDistance>3</throwDistance>
      </li>
    </comps>
  </AbilityDef>

  <AbilityDef ParentName="EntadSelfAbilityBase">
    <defName>Entad_Shockwave</defName>
    <label>shockwave</label>
    <description>Throws every enemy within 3 tiles of the user 3 tiles further away. They are stunned for 1 to 3 seconds where they land. Downed enemies, enemies carrying someone and anything larger than a horse stay where they are.</description>
    <iconPath>UI/Abilities/Entad/Shockwave</iconPath>
    <hostile>true</hostile>
    <comps>
      <li Class="EntadFramework.CompProperties_AbilityEntadShockwave">
        <radius>3.9</radius>
        <distance>3</distance>
        <maxBodySize>2</maxBodySize>
        <fleck>PsycastAreaEffect</fleck>
        <sound>Explosion_Stun</sound>
      </li>
    </comps>
  </AbilityDef>

  <AbilityDef ParentName="EntadAbilityBase">
    <defName>Entad_Harrow</defName>
    <label>harrow</label>
    <description>A wave of dread: each enemy within 6 tiles has a 35% chance to panic and flee, multiplied by their psychic sensitivity. Mechanoids, entities and anyone already in a mental state are unaffected.</description>
    <iconPath>UI/Abilities/Entad/Harrow</iconPath>
    <hostile>true</hostile>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>15</range>
      <targetParams>
        <canTargetLocations>true</canTargetLocations>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="EntadFramework.CompProperties_AbilityEntadHarrow">
        <radius>6</radius>
        <chance>0.35</chance>
        <mentalState>PanicFlee</mentalState>
        <fleck>PsycastAreaEffect</fleck>
      </li>
    </comps>
  </AbilityDef>

  <AbilityDef ParentName="EntadAbilityBase">
    <defName>Entad_Volatile</defName>
    <label>volatile burst</label>
    <description>An explosion with a 2.9-tile radius that hurts only the user's enemies and their buildings. Everyone and everything else in it is spared.</description>
    <iconPath>UI/Abilities/Entad/Volatile</iconPath>
    <hostile>true</hostile>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>15</range>
      <targetParams>
        <canTargetLocations>true</canTargetLocations>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="EntadFramework.CompProperties_AbilityEntadStrike">
        <radius>2.9</radius>
        <spareNonHostile>true</spareNonHostile>
        <damageDef>Bomb</damageDef>
        <damageAmount>25</damageAmount>
      </li>
    </comps>
  </AbilityDef>

  <!-- Flaring's burst: a flame blast on the target that spares the user's side, though the fires it starts don't -->
  <AbilityDef ParentName="EntadAbilityBase">
    <defName>Entad_Flare</defName>
    <label>flare</label>
    <description>A burst of flame around the target, 2.9 tiles across, that burns only the user's enemies. The ground it scorches can still catch fire, and that fire spares nobody.</description>
    <iconPath>UI/Abilities/Entad/Flare</iconPath>
    <hostile>true</hostile>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>15</range>
      <targetParams>
        <canTargetPawns>true</canTargetPawns>
        <canTargetBuildings>true</canTargetBuildings>
        <canTargetLocations>true</canTargetLocations>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="EntadFramework.CompProperties_AbilityEntadStrike">
        <radius>2.9</radius>
        <spareNonHostile>true</spareNonHostile>
        <damageDef>Flame</damageDef>
        <damageAmount>10</damageAmount>
        <visuals>
          <li Class="EntadFramework.EntadVisual_EventFlecks"><at>Other</at><fleck>Entad_Fleck_BurnFlash</fleck><scale>1.4~1.7</scale></li>
          <li Class="EntadFramework.EntadVisual_EventFlecks"><at>Other</at><fleck>Entad_Fleck_FlameLick</fleck><count>5~7</count><scale>0.5~0.8</scale><angle>-25~25</angle><speed>0.6~1.2</speed><rotation>-12~12</rotation><spread>0.9</spread></li>
          <li Class="EntadFramework.EntadVisual_EventFlecks"><at>Other</at><fleck>Entad_Fleck_Ember</fleck><count>6~9</count><scale>0.1~0.16</scale><speed>0.6~1.4</speed><spread>0.6</spread></li>
        </visuals>
      </li>
    </comps>
  </AbilityDef>

  <!-- Crackling's jolt: a crackle of arcs bursting out of the target, never a bolt from the sky (a roof would make
       that look wrong, and VPE's Thunderbolt is the sky strike) -->
  <AbilityDef ParentName="EntadAbilityBase">
    <defName>Entad_Crackle</defName>
    <label>crackle</label>
    <description>Electricity bursts out of the target, dealing 12 arc burn damage, and 15 EMP damage more to a mechanoid.</description>
    <iconPath>UI/Abilities/Entad/Crackle</iconPath>
    <hostile>true</hostile>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>15</range>
      <targetParams>
        <canTargetPawns>true</canTargetPawns>
        <canTargetBuildings>true</canTargetBuildings>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="EntadFramework.CompProperties_AbilityEntadStrike">
        <damageDef>Entad_ArcBurn</damageDef>
        <damageAmount>12</damageAmount>
        <mechanoidDamageDef>EMP</mechanoidDamageDef>
        <mechanoidDamage>15</mechanoidDamage>
        <sound>Explosion_EMP</sound>
        <visuals>
          <li Class="EntadFramework.EntadVisual_EventFlecks"><at>Other</at><fleck>LightningGlow</fleck><scale>1.6~2</scale></li>
          <li Class="EntadFramework.EntadVisual_EventArcs"><at>Other</at><count>5~7</count><reach>0.6~1.3</reach><width>0.24</width><arcTicks>8</arcTicks><fleck>Entad_Fleck_Static</fleck><fleckScale>0.14~0.22</fleckScale></li>
          <li Class="EntadFramework.EntadVisual_EventFlecks"><at>Other</at><fleck>MicroSparks</fleck><count>2~3</count><scale>0.6~0.9</scale><spread>0.3</spread></li>
        </visuals>
      </li>
    </comps>
  </AbilityDef>

  <!-- Arcing's chain: a jolt on the target, then a jagged bolt on to each next enemy -->
  <AbilityDef ParentName="EntadAbilityBase">
    <defName>Entad_ChainArc</defName>
    <label>chain arc</label>
    <description>Electricity strikes the target for 8 arc burn damage, then jumps up to 3 times, each time to the nearest other enemy within 5 tiles in sight of the last one, striking each for the same. Mechanoids take 10 EMP damage more. Downed enemies are passed over.</description>
    <iconPath>UI/Abilities/Entad/ChainArc</iconPath>
    <hostile>true</hostile>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>15</range>
      <targetParams>
        <canTargetPawns>true</canTargetPawns>
        <canTargetBuildings>true</canTargetBuildings>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="EntadFramework.CompProperties_AbilityEntadChain">
        <damageDef>Entad_ArcBurn</damageDef>
        <damageAmount>8</damageAmount>
        <mechanoidDamageDef>EMP</mechanoidDamageDef>
        <mechanoidDamage>10</mechanoidDamage>
        <jumps>3</jumps>
        <jumpRange>5</jumpRange>
        <sound>Explosion_EMP</sound>
        <visuals>
          <li Class="EntadFramework.EntadVisual_EventFlecks"><at>Other</at><fleck>LightningGlow</fleck><scale>1.1~1.4</scale></li>
          <li Class="EntadFramework.EntadVisual_EventArcs"><at>Other</at><count>2~3</count><reach>0.4~0.9</reach><width>0.2</width><arcTicks>10</arcTicks><fleck>Entad_Fleck_Static</fleck></li>
        </visuals>
        <jumpVisuals>
          <li Class="EntadFramework.EntadVisual_EventArcs"><at>Holder</at><to>Other</to><segments>5</segments><jag>0.4</jag><width>0.26</width><arcTicks>12</arcTicks><fleck>Entad_Fleck_Static</fleck></li>
        </jumpVisuals>
      </li>
    </comps>
  </AbilityDef>

  <HediffDef ParentName="EntadHediffBase">
    <defName>Entad_Hediff_Chilled</defName>
    <label>chilled</label>
    <description>Frost clings to this creature's limbs, slowing every movement.</description>
    <defaultLabelColor>(0.6, 0.85, 1)</defaultLabelColor>
    <isBad>true</isBad>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>1200~1200</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <statFactors>
          <MoveSpeed>0.5</MoveSpeed>
          <MeleeCooldownFactor>1.3</MeleeCooldownFactor>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

  <AbilityDef ParentName="EntadSelfAbilityBase">
    <defName>Entad_Frostburst</defName>
    <label>frostburst</label>
    <description>Every enemy next to the user is chilled for 20 seconds: half speed, and melee attacks 30% slower.</description>
    <iconPath>UI/Abilities/Entad/Frostburst</iconPath>
    <hostile>true</hostile>
    <comps>
      <li Class="EntadFramework.CompProperties_AbilityEntadPulse">
        <radius>1.9</radius>
        <targets>Enemies</targets>
        <hediff>Entad_Hediff_Chilled</hediff>
        <fleck>PsycastAreaEffect</fleck>
      </li>
    </comps>
  </AbilityDef>
</Defs>
