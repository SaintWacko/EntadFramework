<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Vanilla psycasts as limited-use abilities. Psyfocus and heat costs are removed; use is limited by charges and cooldown instead. Requires Royalty. -->
  <EntadFramework.EntadTraitDef MayRequire="Ludeon.RimWorld.Royalty">
    <defName>Entad_ChaosSkip</defName>
    <label>Chaos Skip</label>
    <description>Things near it have a way of ending up somewhere else.</description>
    <categories>
      <li>Weapon</li>
      <li>Apparel</li>
    </categories>
    <rarity>Rare</rarity>
    <abilities>
      <li>ChaosSkip</li>
    </abilities>
    <abilityCharges>2</abilityCharges>
    <abilityCooldownTicks>30000</abilityCooldownTicks>
    <abilityCastTicks>60</abilityCastTicks>
  </EntadFramework.EntadTraitDef>
  <EntadFramework.EntadTraitDef MayRequire="Ludeon.RimWorld.Royalty">
    <defName>Entad_Farskip</defName>
    <label>Far Skip</label>
    <description>Distance means less to it than it should.</description>
    <categories>
      <li>Weapon</li>
      <li>Apparel</li>
    </categories>
    <rarity>Rare</rarity>
    <abilities>
      <li>Farskip</li>
    </abilities>
    <abilityCharges>1</abilityCharges>
    <abilityCooldownTicks>60000</abilityCooldownTicks>
    <abilityCastTicks>60</abilityCastTicks>
  </EntadFramework.EntadTraitDef>
  <!-- Reloadable: three charges that only come back by reloading with chemfuel -->
  <EntadFramework.EntadTraitDef MayRequire="Ludeon.RimWorld.Royalty">
    <defName>Entad_StunCharge</defName>
    <label>Stun Charge</label>
    <description>A splash of chemfuel, and it can stop a person in their tracks.</description>
    <categories>
      <li>Weapon</li>
      <li>Apparel</li>
    </categories>
    <rarity>Uncommon</rarity>
    <points>3</points>
    <abilities>
      <li>Stun</li>
    </abilities>
    <abilityCharges>3</abilityCharges>
    <abilityAmmo>Chemfuel</abilityAmmo>
    <abilityAmmoPerCharge>10</abilityAmmoPerCharge>
    <abilityReloadTicks>90</abilityReloadTicks>
  </EntadFramework.EntadTraitDef>
</Defs>
