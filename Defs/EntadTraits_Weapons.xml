<?xml version="1.0" encoding="utf-8"?>
<!-- Weapon-specific entad traits (ranged, melee, and damage effects). -->
<Defs>
  <EntadFramework.EntadTraitDef>
    <defName>Entad_HairTrigger</defName>
    <label>Hair Trigger</label>
    <description>The slightest touch sets it off.</description>
    <categories><li>WeaponRanged</li></categories>
    <rarity>Common</rarity>
    <scalesWithRarity>true</scalesWithRarity>
    <statFactors><li><stat>RangedWeapon_Cooldown</stat><min>0.8</min><max>0.92</max></li></statFactors>
  </EntadFramework.EntadTraitDef>
  <EntadFramework.EntadTraitDef>
    <defName>Entad_RapidVolley</defName>
    <label>Rapid Volley</label>
    <description>Each pull of the trigger lets loose more shots than the weapon was built for.</description>
    <categories><li>WeaponRanged</li></categories>
    <rarity>Rare</rarity>
    <scalesWithRarity>true</scalesWithRarity>
    <weaponProperties><li><property>BurstShotCount</property><min>1.25</min><max>1.5</max></li></weaponProperties>
  </EntadFramework.EntadTraitDef>
  <EntadFramework.EntadTraitDef>
    <defName>Entad_Quickdraw</defName>
    <label>Quickdraw</label>
    <description>It comes to bear on a target almost before you've chosen one.</description>
    <categories><li>WeaponRanged</li></categories>
    <rarity>Uncommon</rarity>
    <scalesWithRarity>true</scalesWithRarity>
    <statOffsets><li><stat>AimingDelayFactor</stat><min>-0.3</min><max>-0.1</max></li></statOffsets>
  </EntadFramework.EntadTraitDef>
  <EntadFramework.EntadTraitDef>
    <defName>Entad_HuntersHush</defName>
    <label>Hunter's Hush</label>
    <description>Prey never quite hears it coming.</description>
    <categories><li>WeaponRanged</li></categories>
    <rarity>Common</rarity>
    <scalesWithRarity>true</scalesWithRarity>
    <statOffsets><li><stat>HuntingStealth</stat><min>0.1</min><max>0.3</max></li></statOffsets>
  </EntadFramework.EntadTraitDef>
  <EntadFramework.EntadTraitDef>
    <defName>Entad_ImpactRounds</defName>
    <label>Impact Rounds</label>
    <description>Its shots knock targets back on their heels.</description>
    <categories><li>WeaponRanged</li></categories>
    <rarity>Uncommon</rarity>
    <scalesWithRarity>true</scalesWithRarity>
    <weaponProperties><li><property>StoppingPower</property><min>0.5</min><max>1</max></li></weaponProperties>
  </EntadFramework.EntadTraitDef>
  <EntadFramework.EntadTraitDef>
    <defName>Entad_Stormsight</defName>
    <label>Stormsight</label>
    <description>Rain, fog and smoke do nothing to spoil its aim.</description>
    <categories><li>WeaponRanged</li></categories>
    <rarity>Rare</rarity>
    <!-- Only matters in bad weather or smoke -->
    <points>2</points>
    <ignoreAccuracyMaluses>true</ignoreAccuracyMaluses>
  </EntadFramework.EntadTraitDef>
  <EntadFramework.EntadTraitDef>
    <defName>Entad_BattleJoy</defName>
    <label>Battle Joy</label>
    <description>The wielder feels a rush of joy with every enemy they kill.</description>
    <categories><li>Weapon</li></categories>
    <rarity>Uncommon</rarity>
    <points>1</points>
    <killThought>Entad_Thought_BattleJoy</killThought>
    <killVictims>Hostile</killVictims>
  </EntadFramework.EntadTraitDef>
  <EntadFramework.EntadTraitDef>
    <defName>Entad_HeavySlugs</defName>
    <label>Heavy Slugs</label>
    <description>Ammunition fired from this weapon hits a little harder.</description>
    <categories><li>WeaponRanged</li></categories>
    <rarity>Common</rarity>
    <scalesWithRarity>true</scalesWithRarity>
    <statFactors><li><stat>RangedWeapon_DamageMultiplier</stat><min>1.08</min><max>1.2</max></li></statFactors>
  </EntadFramework.EntadTraitDef>
  <EntadFramework.EntadTraitDef>
    <defName>Entad_SteadyBarrel</defName>
    <label>Steady Barrel</label>
    <description>There is almost no recoil.</description>
    <categories><li>WeaponRanged</li></categories>
    <rarity>Common</rarity>
    <scalesWithRarity>true</scalesWithRarity>
    <statOffsets><li><stat>AccuracyShort</stat><min>0.02</min><max>0.06</max></li><li><stat>AccuracyMedium</stat><min>0.02</min><max>0.06</max></li></statOffsets>
  </EntadFramework.EntadTraitDef>
  <EntadFramework.EntadTraitDef>
    <defName>Entad_Sharpshooter</defName>
    <label>Sharpshooter</label>
    <description>Every shot is placed with uncanny care and force.</description>
    <categories><li>WeaponRanged</li></categories>
    <rarity>Epic</rarity>
    <!-- Accuracy and damage together, doubled in build 147: priced above a plain Epic -->
    <points>7</points>
    <scalesWithRarity>true</scalesWithRarity>
    <statOffsets><li><stat>AccuracyShort</stat><min>0.06</min><max>0.14</max></li><li><stat>AccuracyMedium</stat><min>0.06</min><max>0.14</max></li><li><stat>AccuracyLong</stat><min>0.06</min><max>0.14</max></li></statOffsets><statFactors><li><stat>RangedWeapon_DamageMultiplier</stat><min>1.2</min><max>1.5</max></li></statFactors>
  </EntadFramework.EntadTraitDef>
  <EntadFramework.EntadTraitDef>
    <defName>Entad_FarReaching</defName>
    <label>Far-Reaching</label>
    <description>Its shots carry further than they have any right to.</description>
    <categories><li>WeaponRanged</li></categories>
    <rarity>Uncommon</rarity>
    <scalesWithRarity>true</scalesWithRarity>
    <!-- Projectile weapons only (StatAppliesTo). Odyssey's unique weapon traits give +15% to +30%. The total is
         capped short of the game's 79-tile radius limit (StatPart_Entad.CapRange). -->
    <statFactors><li><stat>RangedWeapon_RangeMultiplier</stat><min>1.1</min><max>1.2</max></li></statFactors>
  </EntadFramework.EntadTraitDef>
  <EntadFramework.EntadTraitDef>
    <defName>Entad_Piercing</defName>
    <label>Piercing</label>
    <description>Finds the gaps in anything.</description>
    <descriptionMelee>Its edge finds the gaps in any armor.</descriptionMelee>
    <descriptionRanged>Its shots find the gaps in any armor.</descriptionRanged>
    <categories><li>Weapon</li></categories>
    <rarity>Uncommon</rarity>
    <scalesWithRarity>true</scalesWithRarity>
    <!-- One stat per weapon kind; partialStats keeps only the one that fits. Ranged needs a projectile that
         armor can stop (StatAppliesTo). Odyssey's unique weapon traits give +15% to +30%. -->
    <partialStats>true</partialStats>
    <statFactors>
      <li><stat>RangedWeapon_ArmorPenetrationMultiplier</stat><min>1.15</min><max>1.35</max></li>
      <li><stat>Entad_MeleeArmorPenetrationMultiplier</stat><min>1.15</min><max>1.35</max></li>
    </statFactors>
  </EntadFramework.EntadTraitDef>
  <EntadFramework.EntadTraitDef>
    <defName>Entad_HeavyHitter</defName>
    <label>Heavy Hitter</label>
    <description>Its blows hit harder than expected.</description>
    <categories><li>WeaponMelee</li></categories>
    <rarity>Common</rarity>
    <scalesWithRarity>true</scalesWithRarity>
    <statFactors><li><stat>MeleeWeapon_DamageMultiplier</stat><min>1.08</min><max>1.2</max></li></statFactors>
  </EntadFramework.EntadTraitDef>
  <EntadFramework.EntadTraitDef>
    <defName>Entad_RecklessEdge</defName>
    <label>Reckless Edge</label>
    <description>Hits hard, but leaves the wielder off balance.</description>
    <categories><li>WeaponMelee</li></categories>
    <rarity>Uncommon</rarity>
    <scalesWithRarity>true</scalesWithRarity>
    <statFactors><li><stat>MeleeWeapon_DamageMultiplier</stat><min>1.3</min><max>1.7</max></li><li><stat>MeleeWeapon_CooldownMultiplier</stat><min>1.1</min><max>1.3</max></li></statFactors>
  </EntadFramework.EntadTraitDef>
  <EntadFramework.EntadTraitDef>
    <defName>Entad_Bloodthirst</defName>
    <label>Bloodthirst</label>
    <description>Every kill only makes it hungrier.</description>
    <categories><li>WeaponMelee</li></categories>
    <rarity>Uncommon</rarity>
    <triggers>
      <li>
        <on>Kill</on>
        <victims>Hostile</victims>
        <hediff>Entad_Hediff_Bloodthirst</hediff>
        <hediffHours>1</hediffHours>
      </li>
    </triggers>
    <visuals>
      <li Class="EntadFramework.EntadVisual_EventFlecks"><on>Trigger</on><fleck>Entad_Fleck_BloodWisp</fleck><count>4~6</count><scale>0.15~0.25</scale><angle>-30~30</angle><speed>0.4~0.8</speed><spread>0.25</spread></li>
    </visuals>
  </EntadFramework.EntadTraitDef>
  <HediffDef ParentName="EntadHediffBase">
    <defName>Entad_Hediff_Bloodthirst</defName>
    <label>bloodthirst</label>
    <description>Fresh from a kill, this person strikes faster.</description>
    <defaultLabelColor>(0.9, 0.4, 0.4)</defaultLabelColor>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>2500~2500</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <statFactors>
          <MeleeCooldownFactor>0.87</MeleeCooldownFactor>
        </statFactors>
      </li>
    </stages>
  </HediffDef>
  <EntadFramework.EntadTraitDef>
    <defName>Entad_Razoredge</defName>
    <label>Razor-Edged</label>
    <description>Sharp embellishments glint and glisten.</description>
    <categories><li>WeaponMelee</li></categories>
    <rarity>Common</rarity>
    <scalesWithRarity>true</scalesWithRarity>
    <extraDamage><li><damageType>Cut</damageType><min>1</min><max>4</max></li></extraDamage>
  </EntadFramework.EntadTraitDef>
  <EntadFramework.EntadTraitDef>
    <defName>Entad_Emberforged</defName>
    <label>Emberforged</label>
    <description>A weapon formed of pure heat.</description>
    <categories><li>Weapon</li></categories>
    <rarity>Rare</rarity>
    <visible>true</visible>
    <!-- Burn is checked against heat armor instead of sharp or blunt, which most armor is weaker against -->
    <changeDamageType>Burn</changeDamageType>
    <visuals>
      <li Class="EntadFramework.EntadVisual_WeaponGlow">
        <color>(1, 0.45, 0.12, 0.25)</color>
        <pulseSpeed>0.5</pulseSpeed>
        <flicker>0.25</flicker>
      </li>
      <!-- Weapons are thin, so a finer pattern than the apparel's keeps more than one patch on a blade -->
      <li Class="EntadFramework.EntadVisual_WeaponFlow">
        <color>(1, 0.45, 0.08, 0.6)</color>
        <threshold>0.48</threshold>
        <coreThreshold>0.78</coreThreshold>
        <riseAbove>0.12</riseAbove>
        <cellsAcross>8</cellsAcross>
        <cellsUp>5</cellsUp>
        <loopTicks>300</loopTicks>
        <frames>24</frames>
      </li>
      <li Class="EntadFramework.EntadVisual_WeaponFlecks">
        <fleck>Entad_Fleck_Ember</fleck>
        <perSecond>4</perSecond>
        <scale>0.08~0.14</scale>
        <speed>0.25~0.6</speed>
        <angle>-25~25</angle>
      </li>
      <li Class="EntadFramework.EntadVisual_ProjectileTrail">
        <fleck>Entad_Fleck_Ember</fleck>
        <perCell>3</perCell>
        <scale>0.18~0.28</scale>
      </li>
      <li Class="EntadFramework.EntadVisual_EventFlecks"><on>Hit</on><at>Other</at><fleck>Entad_Fleck_BurnFlash</fleck><scale>0.3~0.4</scale></li>
      <li Class="EntadFramework.EntadVisual_EventFlecks"><on>Hit</on><at>Other</at><fleck>Entad_Fleck_FlameLick</fleck><count>1~2</count><scale>0.25~0.35</scale><angle>-20~20</angle><speed>0.4~0.8</speed><rotation>-12~12</rotation><spread>0.2</spread></li>
    </visuals>
  </EntadFramework.EntadTraitDef>
  <EntadFramework.EntadTraitDef>
    <defName>Entad_Searing</defName>
    <label>Searing</label>
    <description>Leaves burns wherever it strikes.</description>
    <descriptionRanged>Its shots leave burns wherever they land.</descriptionRanged>
    <categories><li>Weapon</li></categories>
    <rarity>Uncommon</rarity>
    <scalesWithRarity>true</scalesWithRarity>
    <extraDamage><li><damageType>Burn</damageType><min>1</min><max>4</max></li></extraDamage>
    <visuals>
      <li Class="EntadFramework.EntadVisual_EventFlecks"><on>Hit</on><at>Other</at><fleck>Entad_Fleck_BurnFlash</fleck><scale>0.45~0.55</scale></li>
      <li Class="EntadFramework.EntadVisual_EventFlecks"><on>Hit</on><at>Other</at><fleck>Entad_Fleck_FlameLick</fleck><count>2~3</count><scale>0.35~0.5</scale><angle>-20~20</angle><speed>0.4~0.8</speed><rotation>-12~12</rotation><spread>0.2</spread></li>
      <li Class="EntadFramework.EntadVisual_EventFlecks"><on>Hit</on><at>Other</at><fleck>Entad_Fleck_Ember</fleck><count>3~5</count><scale>0.08~0.14</scale><speed>0.4~1</speed><spread>0.2</spread></li>
    </visuals>
  </EntadFramework.EntadTraitDef>
  <EntadFramework.EntadTraitDef>
    <defName>Entad_Stunning</defName>
    <label>Stunning</label>
    <description>Targets reel from every hit.</description>
    <descriptionMelee>Every blow leaves the target reeling.</descriptionMelee>
    <descriptionRanged>Every shot leaves the target reeling.</descriptionRanged>
    <categories><li>Weapon</li></categories>
    <!-- Stun on every hit can lock a target down, burst weapons especially -->
    <rarity>Rare</rarity>
    <scalesWithRarity>true</scalesWithRarity>
    <extraDamage><li><damageType>Stun</damageType><min>2</min><max>6</max></li></extraDamage>
    <visuals>
      <li Class="EntadFramework.EntadVisual_EventFlecks"><on>Hit</on><at>Other</at><fleck>Entad_Fleck_StunFlash</fleck><scale>0.8~1</scale></li>
      <li Class="EntadFramework.EntadVisual_EventArcs"><on>Hit</on><at>Other</at><arcColor>(1, 0.95, 0.6, 0.9)</arcColor><count>2~3</count><reach>0.35~0.7</reach><arcTicks>8</arcTicks></li>
    </visuals>
  </EntadFramework.EntadTraitDef>
  <EntadFramework.EntadTraitDef>
    <defName>Entad_Shocking</defName>
    <label>Shocking</label>
    <description>Crackles with static, and wrecks machinery.</description>
    <descriptionRanged>Crackles with static, and its shots wreck machinery.</descriptionRanged>
    <categories><li>Weapon</li></categories>
    <rarity>Rare</rarity>
    <visible>true</visible>
    <scalesWithRarity>true</scalesWithRarity>
    <extraDamage><li><damageType>EMP</damageType><min>2</min><max>6</max></li></extraDamage>
    <visuals>
      <li Class="EntadFramework.EntadVisual_WeaponGlow">
        <color>(0.5, 0.75, 1, 0.35)</color>
        <pulseSpeed>0</pulseSpeed>
        <flicker>0.6</flicker>
        <flickerSpeed>0.4</flickerSpeed>
      </li>
      <li Class="EntadFramework.EntadVisual_WeaponArcs">
        <intervalTicks>20</intervalTicks>
        <chance>0.65</chance>
      </li>
      <li Class="EntadFramework.EntadVisual_WeaponFlecks">
        <fleck>Entad_Fleck_Static</fleck>
        <perSecond>1.5</perSecond>
        <scale>0.08~0.12</scale>
        <speed>0.3~0.8</speed>
        <angle>0~360</angle>
      </li>
      <!-- Zaps of lightning from the shot to spots around it, with a spark where each lands -->
      <li Class="EntadFramework.EntadVisual_ProjectileArcs">
        <fleck>Entad_Fleck_Static</fleck>
        <perCell>0.9</perCell>
        <reach>0.5~1.3</reach>
        <scale>0.14~0.22</scale>
        <speed>0.1~0.4</speed>
      </li>
      <li Class="EntadFramework.EntadVisual_EventArcs"><on>Hit</on><at>Other</at><count>2~4</count><reach>0.4~0.8</reach><arcTicks>6</arcTicks><fleck>Entad_Fleck_Static</fleck></li>
    </visuals>
  </EntadFramework.EntadTraitDef>
  <EntadFramework.EntadTraitDef>
    <defName>Entad_Cinderstrike</defName>
    <label>Cinderstrike</label>
    <description>Every hit bursts into flame, and can set the target alight.</description>
    <categories><li>Weapon</li></categories>
    <rarity>Epic</rarity>
    <visible>true</visible>
    <extraDamage>
      <li><damageType>Flame</damageType><min>4</min><max>10</max></li>
    </extraDamage>
    <visuals>
      <li Class="EntadFramework.EntadVisual_WeaponGlow">
        <color>(1, 0.35, 0.05, 0.35)</color>
        <pulseSpeed>0.7</pulseSpeed>
        <flicker>0.3</flicker>
      </li>
      <li Class="EntadFramework.EntadVisual_WeaponFlow">
        <color>(1, 0.4, 0.05, 0.85)</color>
        <threshold>0.38</threshold>
        <coreThreshold>0.7</coreThreshold>
        <riseAbove>0.16</riseAbove>
        <cellsAcross>8</cellsAcross>
        <cellsUp>5</cellsUp>
        <loopTicks>240</loopTicks>
        <scrolls>3</scrolls>
        <evolveCells>4</evolveCells>
        <frames>32</frames>
        <pulseSpeed>0.7</pulseSpeed>
        <pulseMin>0.8</pulseMin>
      </li>
      <li Class="EntadFramework.EntadVisual_WeaponFlecks">
        <fleck>Entad_Fleck_Ember</fleck>
        <perSecond>6</perSecond>
        <scale>0.08~0.16</scale>
        <speed>0.3~0.8</speed>
        <angle>-35~35</angle>
      </li>
      <li Class="EntadFramework.EntadVisual_WeaponFlecks">
        <fleck>Entad_Fleck_CinderSmoke</fleck>
        <perSecond>1.2</perSecond>
        <scale>0.3~0.45</scale>
        <speed>0.2~0.35</speed>
        <angle>-15~15</angle>
        <rotationRate>-20~20</rotationRate>
      </li>
      <li Class="EntadFramework.EntadVisual_ProjectileTrail">
        <fleck>Entad_Fleck_Ember</fleck>
        <perCell>4</perCell>
        <scale>0.18~0.32</scale>
      </li>
      <li Class="EntadFramework.EntadVisual_EventFlecks"><on>Hit</on><at>Other</at><fleck>Entad_Fleck_BurnFlash</fleck><scale>0.6~0.75</scale></li>
      <li Class="EntadFramework.EntadVisual_EventFlecks"><on>Hit</on><at>Other</at><fleck>Entad_Fleck_FlameLick</fleck><count>3~4</count><scale>0.45~0.6</scale><angle>-20~20</angle><speed>0.4~0.8</speed><rotation>-12~12</rotation><spread>0.2</spread></li>
      <li Class="EntadFramework.EntadVisual_EventFlecks"><on>Hit</on><at>Other</at><fleck>Entad_Fleck_CinderSmoke</fleck><scale>0.6~0.8</scale><angle>-15~15</angle><speed>0.2~0.4</speed></li>
      <li Class="EntadFramework.EntadVisual_EventFlecks"><on>Hit</on><at>Other</at><fleck>Entad_Fleck_Ember</fleck><count>5~7</count><scale>0.1~0.16</scale><speed>0.5~1.2</speed><spread>0.25</spread></li>
    </visuals>
  </EntadFramework.EntadTraitDef>
  <EntadFramework.EntadTraitDef>
    <defName>Entad_Frostbite</defName>
    <label>Frostbite</label>
    <description>This weapon's attacks are bitterly cold.</description>
    <categories><li>Weapon</li></categories>
    <rarity>Rare</rarity>
    <visible>true</visible>
    <!-- Extra damage rather than changeDamageType: Frostbite ignores armor and isn't violence, so a weapon converted
         to it would bypass all armor and provoke no retaliation -->
    <extraDamage>
      <li><damageType>Frostbite</damageType><min>2</min><max>6</max></li>
    </extraDamage>
    <visuals>
      <li Class="EntadFramework.EntadVisual_WeaponGlow">
        <color>(0.65, 0.88, 1, 0.4)</color>
        <pulseSpeed>0.3</pulseSpeed>
        <flicker>0.05</flicker>
      </li>
      <!-- Cold air sinks: the mist drifts down the screen -->
      <li Class="EntadFramework.EntadVisual_WeaponFlecks">
        <fleck>Entad_Fleck_FrostMist</fleck>
        <perSecond>3</perSecond>
        <scale>0.25~0.4</scale>
        <speed>0.1~0.25</speed>
        <angle>150~210</angle>
        <rotationRate>-15~15</rotationRate>
      </li>
      <li Class="EntadFramework.EntadVisual_WeaponFlecks">
        <fleck>Entad_Fleck_Glint</fleck>
        <color>(0.4, 0.68, 1)</color>
        <perSecond>1.2</perSecond>
        <scale>0.12~0.2</scale>
        <speed>0~0.05</speed>
      </li>
      <li Class="EntadFramework.EntadVisual_ProjectileTrail">
        <fleck>Entad_Fleck_FrostMist</fleck>
        <perCell>4</perCell>
        <scale>0.45~0.65</scale>
        <speed>0~0.1</speed>
      </li>
      <li Class="EntadFramework.EntadVisual_EventFlecks"><on>Hit</on><at>Other</at><fleck>Entad_Fleck_Glint</fleck><color>(0.4, 0.68, 1)</color><count>3~4</count><scale>0.25~0.4</scale><speed>0.3~0.7</speed><spread>0.2</spread></li>
      <li Class="EntadFramework.EntadVisual_EventFlecks"><on>Hit</on><at>Other</at><fleck>Entad_Fleck_FrostMist</fleck><count>1~2</count><scale>0.6~0.8</scale><speed>0.1~0.3</speed></li>
    </visuals>
  </EntadFramework.EntadTraitDef>
  <EntadFramework.EntadTraitDef>
    <defName>Entad_Merciless</defName>
    <label>Merciless</label>
    <description>It has no patience for those who fall or flee.</description>
    <categories><li>Weapon</li></categories>
    <rarity>Uncommon</rarity>
    <scalesWithRarity>true</scalesWithRarity>
    <statFactors>
      <li><stat>Entad_MercilessDamageFactor</stat><min>1.25</min><max>1.5</max></li>
    </statFactors>
  </EntadFramework.EntadTraitDef>
