    <defName>Entad_Destructive</defName>
    <label>Destructive</label>
    <description>It tears down walls.</description>
    <descriptionMelee>Its blows fall upon the walls like a sledgehammer.</descriptionMelee>
    <descriptionRanged>Its shots fall upon the walls like a sledgehammer.</descriptionRanged>
    <categories><li>Weapon</li></categories>
    <rarity>Uncommon</rarity>
    <scalesWithRarity>true</scalesWithRarity>
    <statFactors>
