<?xml version="1.0" encoding="utf-8"?>
<!-- Weapon-specific entad traits (ranged, melee, and damage effects). -->
<Defs>
  <EntadFramework.EntadTraitDef>
    <defName>Entad_HairTrigger</defName>
    <label>Hair Trigger</label>
    <description>The slightest touch sets it off.</description>
    <categories><li>Weapon</li></categories>
    <rarity>Common</rarity>
    <scalesWithRarity>true</scalesWithRarity>
    <statFactors><li><stat>RangedWeapon_Cooldown</stat><min>0.8</min><max>0.92</max></li></statFactors>
  </EntadFramework.EntadTraitDef>
  <EntadFramework.EntadTraitDef>
    <defName>Entad_RapidVolley</defName>
    <label>Rapid Volley</label>
    <description>Each pull of the trigger lets loose more shots than the weapon was built for.</description>
    <categories><li>Weapon</li></categories>
    <rarity>Rare</rarity>
    <scalesWithRarity>true</scalesWithRarity>
    <weaponProperties><li><property>BurstShotCount</property><min>1.25</min><max>1.5</max></li></weaponProperties>
  </EntadFramework.EntadTraitDef>
  <EntadFramework.EntadTraitDef>
    <defName>Entad_Quickfire</defName>
    <label>Quickfire</label>
    <description>Shots in a burst follow one another faster.</description>
    <categories><li>Weapon</li></categories>
    <rarity>Uncommon</rarity>
    <scalesWithRarity>true</scalesWithRarity>
    <weaponProperties><li><property>BurstShotSpeed</property><min>1.2</min><max>1.5</max></li></weaponProperties>
  </EntadFramework.EntadTraitDef>
  <EntadFramework.EntadTraitDef>
    <defName>Entad_ImpactRounds</defName>
    <label>Impact Rounds</label>
    <description>Its shots knock targets back on their heels, slowing them down.</description>
    <categories><li>Weapon</li></categories>
    <rarity>Uncommon</rarity>
    <scalesWithRarity>true</scalesWithRarity>
    <weaponProperties><li><property>StoppingPower</property><min>0.5</min><max>1</max></li></weaponProperties>
  </EntadFramework.EntadTraitDef>
  <EntadFramework.EntadTraitDef>
    <defName>Entad_Stormsight</defName>
    <label>Stormsight</label>
    <description>Rain, fog and smoke do nothing to spoil its aim.</description>
    <categories><li>Weapon</li></categories>
    <rarity>Rare</rarity>
    <!-- Only matters in bad weather or smoke -->
    <points>3</points>
    <ignoreAccuracyMaluses>true</ignoreAccuracyMaluses>
  </EntadFramework.EntadTraitDef>
  <EntadFramework.EntadTraitDef>
    <defName>Entad_BattleJoy</defName>
    <label>Battle Joy</label>
    <description>The wielder feels a rush of joy with every enemy they kill.</description>
    <categories><li>Weapon</li></categories>
    <rarity>Uncommon</rarity>
    <killThought>Entad_Thought_BattleJoy</killThought>
    <killVictims>Hostile</killVictims>
  </EntadFramework.EntadTraitDef>
  <EntadFramework.EntadTraitDef>
    <defName>Entad_HeavySlugs</defName>
    <label>Heavy Slugs</label>
    <description>Ammunition fired from this weapon hits a little harder.</description>
    <categories><li>Weapon</li></categories>
    <rarity>Common</rarity>
    <scalesWithRarity>true</scalesWithRarity>
    <statFactors><li><stat>RangedWeapon_DamageMultiplier</stat><min>1.08</min><max>1.2</max></li></statFactors>
  </EntadFramework.EntadTraitDef>
  <EntadFramework.EntadTraitDef>
    <defName>Entad_SteadyBarrel</defName>
    <label>Steady Barrel</label>
    <description>There is almost no recoil.</description>
    <categories><li>Weapon</li></categories>
    <rarity>Common</rarity>
    <scalesWithRarity>true</scalesWithRarity>
    <statOffsets><li><stat>AccuracyShort</stat><min>0.02</min><max>0.06</max></li><li><stat>AccuracyMedium</stat><min>0.02</min><max>0.06</max></li></statOffsets>
  </EntadFramework.EntadTraitDef>
  <EntadFramework.EntadTraitDef>
    <defName>Entad_Sharpshooter</defName>
    <label>Sharpshooter</label>
    <description>Every shot is placed with uncanny care and force.</description>
    <categories><li>Weapon</li></categories>
    <rarity>Epic</rarity>
    <scalesWithRarity>true</scalesWithRarity>
    <statOffsets><li><stat>AccuracyShort</stat><min>0.03</min><max>0.07</max></li><li><stat>AccuracyMedium</stat><min>0.03</min><max>0.07</max></li><li><stat>AccuracyLong</stat><min>0.03</min><max>0.07</max></li></statOffsets><statFactors><li><stat>RangedWeapon_DamageMultiplier</stat><min>1.1</min><max>1.25</max></li></statFactors>
  </EntadFramework.EntadTraitDef>
  <EntadFramework.EntadTraitDef>
    <defName>Entad_HeavyHitter</defName>
    <label>Heavy Hitter</label>
    <description>It carries more weight than it should.</description>
    <categories><li>Weapon</li></categories>
    <rarity>Common</rarity>
    <scalesWithRarity>true</scalesWithRarity>
    <statFactors><li><stat>MeleeWeapon_DamageMultiplier</stat><min>1.08</min><max>1.2</max></li></statFactors>
  </EntadFramework.EntadTraitDef>
  <EntadFramework.EntadTraitDef>
    <defName>Entad_RecklessEdge</defName>
    <label>Reckless Edge</label>
    <description>Hits hard, but leaves the wielder off balance.</description>
    <categories><li>Weapon</li></categories>
    <rarity>Uncommon</rarity>
    <scalesWithRarity>true</scalesWithRarity>
    <statFactors><li><stat>MeleeWeapon_DamageMultiplier</stat><min>1.3</min><max>1.7</max></li><li><stat>MeleeWeapon_CooldownMultiplier</stat><min>1.1</min><max>1.3</max></li></statFactors>
  </EntadFramework.EntadTraitDef>
  <EntadFramework.EntadTraitDef>
    <defName>Entad_Bruising</defName>
    <label>Bruising</label>
    <description>Blows leave deep bruises.</description>
    <categories><li>Weapon</li></categories>
    <rarity>Common</rarity>
    <scalesWithRarity>true</scalesWithRarity>
    <extraDamage><li><damageType>Blunt</damageType><min>1</min><max>4</max></li></extraDamage>
  </EntadFramework.EntadTraitDef>
  <EntadFramework.EntadTraitDef>
    <defName>Entad_Razoredge</defName>
    <label>Razor-Edged</label>
    <description>Cuts far deeper than the blade should.</description>
    <categories><li>Weapon</li></categories>
    <rarity>Common</rarity>
    <scalesWithRarity>true</scalesWithRarity>
    <extraDamage><li><damageType>Cut</damageType><min>1</min><max>4</max></li></extraDamage>
  </EntadFramework.EntadTraitDef>
  <EntadFramework.EntadTraitDef>
    <defName>Entad_Piercing</defName>
    <label>Piercing</label>
    <description>Finds the gaps in anything.</description>
    <categories><li>Weapon</li></categories>
    <rarity>Common</rarity>
    <scalesWithRarity>true</scalesWithRarity>
    <extraDamage><li><damageType>Stab</damageType><min>1</min><max>4</max></li></extraDamage>
  </EntadFramework.EntadTraitDef>
  <EntadFramework.EntadTraitDef>
    <defName>Entad_Searing</defName>
    <label>Searing</label>
    <description>Leaves burns wherever it strikes.</description>
    <categories><li>Weapon</li></categories>
    <rarity>Uncommon</rarity>
    <scalesWithRarity>true</scalesWithRarity>
    <extraDamage><li><damageType>Burn</damageType><min>1</min><max>4</max></li></extraDamage>
  </EntadFramework.EntadTraitDef>
  <EntadFramework.EntadTraitDef>
    <defName>Entad_Stunning</defName>
    <label>Stunning</label>
    <description>Targets reel from every hit.</description>
    <categories><li>Weapon</li></categories>
    <rarity>Uncommon</rarity>
    <scalesWithRarity>true</scalesWithRarity>
    <extraDamage><li><damageType>Stun</damageType><min>2</min><max>6</max></li></extraDamage>
  </EntadFramework.EntadTraitDef>
  <EntadFramework.EntadTraitDef>
    <defName>Entad_Shocking</defName>
    <label>Shocking</label>
    <description>Crackles with static, and wrecks machinery.</description>
    <categories><li>Weapon</li></categories>
    <rarity>Rare</rarity>
    <scalesWithRarity>true</scalesWithRarity>
    <extraDamage><li><damageType>EMP</damageType><min>2</min><max>6</max></li></extraDamage>
  </EntadFramework.EntadTraitDef>
  <EntadFramework.EntadTraitDef>
    <defName>Entad_Cinderstrike</defName>
    <label>Cinderstrike</label>
    <description>Every hit bursts into flame, and can set the target alight.</description>
    <categories><li>Weapon</li></categories>
    <rarity>Epic</rarity>
    <extraDamage>
      <li><damageType>Flame</damageType><min>4</min><max>10</max></li>
    </extraDamage>
  </EntadFramework.EntadTraitDef>
  <EntadFramework.EntadTraitDef>
    <defName>Entad_Frostbite</defName>
    <label>Frostbite</label>
    <description>This weapon's attacks are bitterly cold.</description>
    <categories><li>Weapon</li></categories>
    <rarity>Rare</rarity>
    <!-- Extra damage rather than changeDamageType: Frostbite ignores armor and isn't violence, so a weapon converted
         to it would bypass all armor and provoke no retaliation -->
    <extraDamage>
      <li><damageType>Frostbite</damageType><min>2</min><max>6</max></li>
    </extraDamage>
  </EntadFramework.EntadTraitDef>
</Defs>
