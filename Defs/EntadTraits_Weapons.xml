    <rarity>Common</rarity>
    <scalesWithRarity>true</scalesWithRarity>
    <statOffsets><li><stat>AccuracyShort</stat><min>0.02</min><max>0.06</max></li><li><stat>AccuracyMedium</stat><min>0.02</min><max>0.06</max></li></statOffsets>
