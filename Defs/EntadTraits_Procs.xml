<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Royalty psycasts cast by triggers (EntadProcs.cs): at once, no psylink, psyfocus or heat, ignoring the psycast's
       range and line of sight. A psycast that can't go off (a psychically deaf target, nowhere to skip to) skips the
       trigger (and keeps its cooldown, where it has one). Durations still scale with the target's psychic sensitivity, as the psycast's do.
       Vanilla Psycasts Expanded's copies of these psycasts aren't used: VPE needs Royalty, so these cover it. -->

  <EntadFramework.EntadTraitDef MayRequire="Ludeon.RimWorld.Royalty">
    <defName>Entad_Proc_Burden</defName>
    <label>Burdening</label>
    <description>Those it strikes feel the weight of every step afterwards.</description>
    <categories><li>Weapon</li></categories>
    <rarity>Uncommon</rarity>
    <scalesWithRarity>true</scalesWithRarity>
    <triggers>
      <li>
        <on>Hit</on>
        <victims>Hostile</victims>
        <chance>0.06~0.08</chance>
        <rarityScales>Chance</rarityScales>
        <rateNormalized>1</rateNormalized>
        <adaptSeconds>30</adaptSeconds>
        <adaptFactor>0.5</adaptFactor>
        <casts>
          <li><ability>Burden</ability><target>Victim</target></li>
        </casts>
      </li>
    </triggers>
    <visuals>
      <li Class="EntadFramework.EntadVisual_EventRibbons"><on>Trigger</on><from>Holder</from><to>Other</to><color>(0.45, 0.6, 1)</color></li>
    </visuals>
  </EntadFramework.EntadTraitDef>

  <EntadFramework.EntadTraitDef MayRequire="Ludeon.RimWorld.Royalty">
    <defName>Entad_Proc_Stun</defName>
    <label>Staggering</label>
    <description>Now and then a hit from it lands harder on the mind than on the body.</description>
    <categories><li>Weapon</li></categories>
    <rarity>Rare</rarity>
    <scalesWithRarity>true</scalesWithRarity>
    <triggers>
      <li>
        <on>Hit</on>
        <victims>Hostile</victims>
        <chance>0.05~0.07</chance>
        <rarityScales>Chance</rarityScales>
        <rateNormalized>1</rateNormalized>
        <adaptSeconds>12</adaptSeconds>
        <adaptFactor>0.5</adaptFactor>
        <casts>
          <li><ability>Stun</ability><target>Victim</target></li>
        </casts>
      </li>
    </triggers>
    <visuals>
      <li Class="EntadFramework.EntadVisual_EventRibbons"><on>Trigger</on><from>Holder</from><to>Other</to><color>(1, 0.88, 0.35)</color></li>
    </visuals>
  </EntadFramework.EntadTraitDef>

  <EntadFramework.EntadTraitDef MayRequire="Ludeon.RimWorld.Royalty">
    <defName>Entad_Proc_Berserk</defName>
    <label>Maddening</label>
    <description>Some it wounds forget which side they are on.</description>
    <categories><li>Weapon</li></categories>
    <rarity>Epic</rarity>
    <scalesWithRarity>true</scalesWithRarity>
    <triggers>
      <li>
        <on>Hit</on>
        <victims>Hostile</victims>
        <chance>0.05</chance>
        <cooldownHours>20~28</cooldownHours>
        <rarityScales>Cooldown</rarityScales>
        <rateNormalized>1</rateNormalized>
        <adaptSeconds>60</adaptSeconds>
        <casts>
          <li><ability>Berserk</ability><target>Victim</target></li>
        </casts>
      </li>
    </triggers>
    <visuals>
      <li Class="EntadFramework.EntadVisual_EventRibbons"><on>Trigger</on><from>Holder</from><to>Other</to><color>(1, 0.25, 0.85)</color></li>
    </visuals>
  </EntadFramework.EntadTraitDef>

  <!-- Ranged damage from 5+ tiles: the pulse blinds everyone within 3.9 tiles of the attacker, the wearer included -->
  <EntadFramework.EntadTraitDef MayRequire="Ludeon.RimWorld.Royalty">
    <defName>Entad_Proc_BlindingPulse</defName>
    <label>Dazzling</label>
    <description>Whoever takes aim at its owner sometimes finds the world has gone white.</description>
    <categories><li>Apparel</li></categories>
    <rarity>Rare</rarity>
    <scalesWithRarity>true</scalesWithRarity>
    <triggers>
      <li>
        <on>TakeDamage</on>
        <attack>Ranged</attack>
        <fromEnemy>true</fromEnemy>
        <minDistance>5</minDistance>
        <chance>0.25</chance>
        <cooldownSeconds>30~45</cooldownSeconds>
        <rarityScales>Cooldown</rarityScales>
        <casts>
          <li><ability>BlindingPulse</ability><target>Attacker</target></li>
        </casts>
      </li>
    </triggers>
  </EntadFramework.EntadTraitDef>

  <EntadFramework.EntadTraitDef MayRequire="Ludeon.RimWorld.Royalty">
    <defName>Entad_Proc_ChaosSkip</defName>
    <label>Elusive</label>
    <description>Grab for its owner and you may find your hands empty.</description>
    <categories><li>Apparel</li></categories>
    <rarity>Rare</rarity>
    <scalesWithRarity>true</scalesWithRarity>
    <triggers>
      <li>
        <on>TakeDamage</on>
        <attack>Melee</attack>
        <fromEnemy>true</fromEnemy>
        <chance>0.2</chance>
        <cooldownSeconds>30~45</cooldownSeconds>
        <rarityScales>Cooldown</rarityScales>
        <casts>
          <li><ability>ChaosSkip</ability><target>Self</target></li>
        </casts>
      </li>
    </triggers>
  </EntadFramework.EntadTraitDef>

  <!-- The attacker is skipped 7-25 tiles in a random direction, which can land them behind the holder's lines, and
       stunned for 1-2 seconds on arrival. Vanilla won't skip anything over body size 3.5 or a psychically deaf pawn,
       and the trigger keeps its cooldown then. Like the psycast, each skip costs 15 goodwill with the attacker's
       faction (vanilla's goodwillImpact). One melee answer per item, like Thorned, Infernal and Stormcloak. -->
  <EntadFramework.EntadTraitDef MayRequire="Ludeon.RimWorld.Royalty">
    <defName>Entad_Proc_Banish</defName>
    <label>Banishing</label>
    <description>Those who come to blows with its owner are sometimes simply elsewhere.</description>
    <categories><li>Apparel</li></categories>
    <rarity>Rare</rarity>
    <scalesWithRarity>true</scalesWithRarity>
    <exclusivityTags><li>EntadMeleeRetaliation</li></exclusivityTags>
    <triggers>
      <li>
        <on>TakeDamage</on>
        <attack>Melee</attack>
        <fromEnemy>true</fromEnemy>
        <chance>0.25</chance>
        <cooldownSeconds>30~45</cooldownSeconds>
        <rarityScales>Cooldown</rarityScales>
        <casts>
          <li><ability>ChaosSkip</ability><target>Attacker</target></li>
        </casts>
      </li>
    </triggers>
  </EntadFramework.EntadTraitDef>

  <EntadFramework.EntadTraitDef MayRequire="Ludeon.RimWorld.Royalty">
    <defName>Entad_Proc_Invisibility</defName>
    <label>Fading</label>
    <description>When its owner is badly hurt, the eye slides off them.</description>
    <categories><li>Apparel</li></categories>
    <rarity>Epic</rarity>
    <scalesWithRarity>true</scalesWithRarity>
    <triggers>
      <li>
        <on>TakeDamage</on>
        <fromEnemy>true</fromEnemy>
        <healthBelow>0.5</healthBelow>
        <cooldownHours>40~56</cooldownHours>
        <rarityScales>Cooldown</rarityScales>
        <casts>
          <li><ability>Invisibility</ability><target>Self</target></li>
        </casts>
      </li>
    </triggers>
  </EntadFramework.EntadTraitDef>

  <!-- The framework's own proc abilities (EntadProcAbilities.xml): no DLC. Weapons proc on what they hit or kill,
       apparel on being hurt. -->

  <!-- Only on weapons whose primary verb fires a projectile (as Artillery). The bounce starts where the target
       stood, so it also goes off on a killing shot. An explosive projectile bounces too, and its blast spares nobody. -->
  <EntadFramework.EntadTraitDef>
    <defName>Entad_Proc_Ricochet</defName>
    <label>Ricochet</label>
    <description>Impossibly, its shots sometimes bounce between enemies.</description>
    <categories><li>WeaponRanged</li></categories>
    <rarity>Rare</rarity>
    <scalesWithRarity>true</scalesWithRarity>
    <triggers>
      <li>
        <on>Hit</on>
        <attack>Ranged</attack>
        <victims>Hostile</victims>
        <chance>0.12~0.16</chance>
        <rarityScales>Chance</rarityScales>
        <casts>
          <li><ability>Entad_Ricochet</ability><target>VictimCell</target></li>
        </casts>
      </li>
    </triggers>
  </EntadFramework.EntadTraitDef>

  <!-- People only: an animal has no weapon, and a mech's gun can't be dropped. A hit on either does nothing. -->
  <EntadFramework.EntadTraitDef>
    <defName>Entad_Proc_Disarm</defName>
    <label>Disarming</label>
    <description>Sometimes the weapon twists on its own to knock the blade from the foe's hand.</description>
    <categories><li>WeaponMelee</li></categories>
    <rarity>Rare</rarity>
    <scalesWithRarity>true</scalesWithRarity>
    <triggers>
      <li>
        <on>Hit</on>
        <attack>Melee</attack>
        <victims>Hostile</victims>
        <chance>0.06~0.08</chance>
        <rarityScales>Chance</rarityScales>
        <rateNormalized>1</rateNormalized>
        <adaptSeconds>30</adaptSeconds>
        <casts>
          <li><ability>Entad_Disarm</ability><target>Victim</target></li>
        </casts>
      </li>
    </triggers>
  </EntadFramework.EntadTraitDef>

  <EntadFramework.EntadTraitDef>
    <defName>Entad_Proc_Harrow</defName>
    <label>Harrowing</label>
    <description>Those who see what it does to one of them lose their nerve for the fight.</description>
    <categories><li>Weapon</li></categories>
    <rarity>Rare</rarity>
    <scalesWithRarity>true</scalesWithRarity>
    <triggers>
      <li>
        <on>Kill</on>
        <victims>Hostile</victims>
        <chance>0.2~0.3</chance>
        <rarityScales>Chance</rarityScales>
        <casts>
          <li><ability>Entad_Harrow</ability><target>VictimCell</target></li>
        </casts>
      </li>
    </triggers>
    <visuals>
      <li Class="EntadFramework.EntadVisual_EventFlecks"><on>Trigger</on><at>Other</at><fleck>Entad_Fleck_DreadWisp</fleck><count>10~13</count><scale>0.8~1.2</scale><speed>0.6~1.2</speed><spread>0.45</spread></li>
    </visuals>
  </EntadFramework.EntadTraitDef>

  <EntadFramework.EntadTraitDef>
    <defName>Entad_Proc_Volatile</defName>
    <label>Volatile</label>
    <description>What it kills sometimes goes off like a grenade.</description>
    <categories><li>Weapon</li></categories>
    <rarity>Uncommon</rarity>
    <scalesWithRarity>true</scalesWithRarity>
    <triggers>
      <li>
        <on>Kill</on>
        <victims>Hostile</victims>
        <chance>0.15~0.2</chance>
        <rarityScales>Chance</rarityScales>
        <scaleWithDamage>0.5</scaleWithDamage>
        <casts>
          <li><ability>Entad_Volatile</ability><target>VictimCell</target></li>
        </casts>
      </li>
    </triggers>
  </EntadFramework.EntadTraitDef>

  <!-- Ranged hits 6+ tiles out: the burst spares the holder's side, but the ground fires it starts don't -->
  <EntadFramework.EntadTraitDef>
    <defName>Entad_Proc_Flaring</defName>
    <label>Flaring</label>
    <description>Every so often a shot from it lands in a burst of flame.</description>
    <categories><li>WeaponRanged</li></categories>
    <rarity>Uncommon</rarity>
    <scalesWithRarity>true</scalesWithRarity>
    <triggers>
      <li>
        <on>Hit</on>
        <attack>Ranged</attack>
        <victims>Hostile</victims>
        <minDistance>6</minDistance>
        <chance>0.15~0.2</chance>
        <rarityScales>Chance</rarityScales>
        <rateNormalized>0.5</rateNormalized>
        <scaleWithDamage>0.5</scaleWithDamage>
        <casts>
          <li><ability>Entad_Flare</ability><target>Victim</target></li>
        </casts>
      </li>
    </triggers>
  </EntadFramework.EntadTraitDef>

  <EntadFramework.EntadTraitDef>
    <defName>Entad_Proc_Crackling</defName>
    <label>Crackling</label>
    <description>The air around its barrel tastes of copper before a storm.</description>
    <categories><li>WeaponRanged</li></categories>
    <rarity>Uncommon</rarity>
    <scalesWithRarity>true</scalesWithRarity>
    <triggers>
      <li>
        <on>Hit</on>
        <attack>Ranged</attack>
        <victims>Hostile</victims>
        <chance>0.22~0.3</chance>
        <rarityScales>Chance</rarityScales>
        <rateNormalized>0.5</rateNormalized>
        <scaleWithDamage>0.5</scaleWithDamage>
        <casts>
          <li><ability>Entad_Crackle</ability><target>Victim</target></li>
        </casts>
      </li>
    </triggers>
  </EntadFramework.EntadTraitDef>

  <!-- Only ever jumps onto enemies, so no minimum distance -->
  <EntadFramework.EntadTraitDef>
    <defName>Entad_Proc_Arcing</defName>
    <label>Arcing</label>
    <description>Hungry lightning seeks out more targets.</description>
    <categories><li>WeaponRanged</li></categories>
    <rarity>Rare</rarity>
    <scalesWithRarity>true</scalesWithRarity>
    <triggers>
      <li>
        <on>Hit</on>
        <attack>Ranged</attack>
        <victims>Hostile</victims>
        <chance>0.15~0.2</chance>
        <rarityScales>Chance</rarityScales>
        <rateNormalized>0.5</rateNormalized>
        <scaleWithDamage>0.5</scaleWithDamage>
        <casts>
          <li><ability>Entad_ChainArc</ability><target>Victim</target></li>
        </casts>
      </li>
    </triggers>
  </EntadFramework.EntadTraitDef>

  <EntadFramework.EntadTraitDef>
    <defName>Entad_Proc_Shockwave</defName>
    <label>Shockwave</label>
    <description>Crowd its owner, and the air itself pushes back.</description>
    <categories><li>Apparel</li></categories>
    <rarity>Rare</rarity>
    <scalesWithRarity>true</scalesWithRarity>
    <triggers>
      <li>
        <on>TakeDamage</on>
        <attack>Melee</attack>
        <fromEnemy>true</fromEnemy>
        <chance>0.25</chance>
        <cooldownSeconds>20~30</cooldownSeconds>
        <rarityScales>Cooldown</rarityScales>
        <casts>
          <li><ability>Entad_Shockwave</ability><target>Self</target></li>
        </casts>
      </li>
    </triggers>
  </EntadFramework.EntadTraitDef>

  <EntadFramework.EntadTraitDef>
    <defName>Entad_Proc_Frostburst</defName>
    <label>Frostburst</label>
    <description>Those who strike its owner up close come away with frost in their joints.</description>
    <categories><li>Apparel</li></categories>
    <rarity>Uncommon</rarity>
    <scalesWithRarity>true</scalesWithRarity>
    <triggers>
      <li>
        <on>TakeDamage</on>
        <attack>Melee</attack>
        <fromEnemy>true</fromEnemy>
        <chance>0.3</chance>
        <cooldownSeconds>15~20</cooldownSeconds>
        <rarityScales>Cooldown</rarityScales>
        <casts>
          <li><ability>Entad_Frostburst</ability><target>Self</target></li>
        </casts>
      </li>
    </triggers>
    <!-- Cold air sinks: a little mist slides off the wearer and pools round the feet -->
    <visuals>
      <li Class="EntadFramework.EntadVisual_WeaponGlow">
        <color>(0.65, 0.88, 1, 0.16)</color>
        <pulseSpeed>0.3</pulseSpeed>
        <flicker>0.05</flicker>
        <tint>1.2</tint>
      </li>
      <li Class="EntadFramework.EntadVisual_WornFlecks">
        <fleck>Entad_Fleck_FrostMistWorn</fleck>
        <perSecond>3</perSecond>
        <scale>0.45~0.65</scale>
        <speed>0.15~0.3</speed>
        <angle>150~210</angle>
        <rotationRate>-15~15</rotationRate>
        <x>-0.25~0.25</x>
        <z>-0.3~-0.05</z>
      </li>
    </visuals>
  </EntadFramework.EntadTraitDef>
</Defs>
