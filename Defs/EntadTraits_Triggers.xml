<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Triggered effects (EntadTriggers.cs): "when X happens, do Y". Amounts scale with rarity; chance and cooldown don't. -->

  <EntadFramework.EntadTraitDef>
    <defName>Entad_LastStand</defName>
    <label>Last Stand</label>
    <description>It refuses to let its bearer stay down for long.</description>
    <categories>
      <li>Weapon</li>
      <li>Apparel</li>
    </categories>
    <rarity>Rare</rarity>
    <scalesWithRarity>true</scalesWithRarity>
    <triggers>
      <li>
        <on>Downed</on>
        <heal>30~40</heal>
        <cooldownHours>24</cooldownHours>
      </li>
    </triggers>
    <visuals>
      <li Class="EntadFramework.EntadVisual_EventFlecks"><on>Trigger</on><at>Holder</at><fleck>Entad_Fleck_HealPulse</fleck><scale>1.5~1.7</scale></li>
      <li Class="EntadFramework.EntadVisual_EventFlecks"><on>Trigger</on><at>Holder</at><fleck>Entad_Fleck_HealMote</fleck><count>5~7</count><scale>0.12~0.2</scale><angle>-25~25</angle><speed>0.3~0.6</speed><spread>0.3</spread></li>
    </visuals>
  </EntadFramework.EntadTraitDef>

  <EntadFramework.EntadTraitDef>
    <defName>Entad_MendingRest</defName>
    <label>Mending Rest</label>
    <description>Sleep here mends more than tiredness.</description>
    <categories>
      <li>Furniture</li>
    </categories>
    <rarity>Uncommon</rarity>
    <scalesWithRarity>true</scalesWithRarity>
    <triggers>
      <li>
        <on>Use</on>
        <use>Sleep</use>
        <heal>6~10</heal>
      </li>
    </triggers>
    <visuals>
      <li Class="EntadFramework.EntadVisual_EventFlecks"><on>Trigger</on><at>Affected</at><fleck>Entad_Fleck_HealPulse</fleck><scale>1~1.2</scale></li>
      <li Class="EntadFramework.EntadVisual_EventFlecks"><on>Trigger</on><at>Affected</at><fleck>Entad_Fleck_HealMote</fleck><count>2~3</count><scale>0.12~0.2</scale><angle>-25~25</angle><speed>0.3~0.6</speed><spread>0.3</spread></li>
    </visuals>
  </EntadFramework.EntadTraitDef>

  <EntadFramework.EntadTraitDef>
    <defName>Entad_Thunderclap</defName>
    <label>Thunderclap</label>
    <description>Some deaths it greets with a crack of thunder.</description>
    <categories><li>Weapon</li></categories>
    <rarity>Rare</rarity>
    <scalesWithRarity>true</scalesWithRarity>
    <triggers>
      <li>
        <on>Kill</on>
        <victims>Hostile</victims>
        <chance>0.2</chance>
        <stunSeconds>2~3</stunSeconds>
        <radius>4</radius>
        <atVictim>true</atVictim>
        <targets>Enemies</targets>
        <fleck>PsycastAreaEffect</fleck>
        <sound>Thunder_OnMap</sound>
      </li>
    </triggers>
    <visuals>
      <li Class="EntadFramework.EntadVisual_EventArcs"><on>Trigger</on><at>Other</at><to>Affected</to><segments>4</segments><jag>0.35</jag><width>0.24</width><arcTicks>10</arcTicks><fleck>Entad_Fleck_Static</fleck></li>
    </visuals>
  </EntadFramework.EntadTraitDef>

  <EntadFramework.EntadTraitDef>
    <defName>Entad_Muse</defName>
    <label>Muse</label>
    <description>It whispers ideas into its owner's dreams.</description>
    <categories><li>Weapon</li><li>Apparel</li></categories>
    <rarity>Rare</rarity>
    <!-- Nothing rolled, so nothing to scale. Vanilla inspirations come every few weeks at high mood. -->
    <triggers>
      <li>
        <on>WakeUp</on>
        <chance>0.1</chance>
        <cooldownHours>48</cooldownHours>
        <randomInspiration>true</randomInspiration>
      </li>
    </triggers>
    <visuals>
      <li Class="EntadFramework.EntadVisual_EventFlecks"><on>Trigger</on><fleck>Entad_Fleck_GoldGlint</fleck><count>4~6</count><scale>0.3~0.45</scale><angle>-40~40</angle><speed>0.1~0.3</speed><spread>0.35</spread></li>
    </visuals>
  </EntadFramework.EntadTraitDef>

  <EntadFramework.EntadTraitDef>
    <defName>Entad_Hearthward</defName>
    <label>Hearthward</label>
    <description>When its sleeper wakes, everyone sharing the room feels a little more whole.</description>
    <categories><li>Furniture</li></categories>
    <rarity>Uncommon</rarity>
    <scalesWithRarity>true</scalesWithRarity>
    <!-- Mending Rest heals the sleeper; this heals everyone of the sleeper's faction in the room (awake ones, animals and prisoners too), less and not every night -->
    <triggers>
      <li>
        <on>Use</on>
        <use>Sleep</use>
        <chance>0.35</chance>
        <heal>3~6</heal>
        <radius>7</radius>
        <sameRoom>true</sameRoom>
        <targets>Self, Allies</targets>
      </li>
    </triggers>
    <visuals>
      <li Class="EntadFramework.EntadVisual_EventFlecks"><on>Trigger</on><at>Affected</at><fleck>Entad_Fleck_HealPulse</fleck><scale>1~1.2</scale></li>
      <li Class="EntadFramework.EntadVisual_EventFlecks"><on>Trigger</on><at>Affected</at><fleck>Entad_Fleck_HealMote</fleck><count>2~3</count><scale>0.12~0.2</scale><angle>-25~25</angle><speed>0.3~0.6</speed><spread>0.3</spread></li>
    </visuals>
  </EntadFramework.EntadTraitDef>
</Defs>
