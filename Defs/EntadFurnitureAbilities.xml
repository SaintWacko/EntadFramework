<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Given by the Restful furniture trait's Use trigger (EntadTraits_Furniture.xml), and by the example ability below -->
  <HediffDef ParentName="EntadHediffBase">
    <defName>Entad_RestfulCalm</defName>
    <label>restful calm</label>
    <description>A deep, settled calm that dulls pain without clouding the mind.</description>
    <defaultLabelColor>(0.7, 1.0, 0.7)</defaultLabelColor>
    <stages>
      <li>
        <painFactor>0.5</painFactor>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>10000~10000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
  </HediffDef>

  <AbilityDef>
    <defName>Entad_RestfulSigh</defName>
    <label>restful sigh</label>
    <description>Halves the user's pain for 4 hours.</description>
    <iconPath>UI/Commands/Draft</iconPath>
    <cooldownTicksRange>60000~60000</cooldownTicksRange>
    <targetRequired>false</targetRequired>
    <!-- Abilities default to hostile, which would mark the pawn as in combat every time it rests -->
    <hostile>false</hostile>
    <!-- The hediff's own disappearsAfterTicks is overwritten by CompAbilityEffect_GiveHediff with this duration
         (seconds; 167 s = about 10000 ticks, 4 in-game hours). Without it the hediff would vanish on its next tick. -->
    <statBases>
      <Ability_Duration>167</Ability_Duration>
    </statBases>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <label>restful sigh</label>
      <range>0</range>
      <targetable>false</targetable>
      <targetParams>
        <canTargetSelf>true</canTargetSelf>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="CompProperties_AbilityGiveHediff">
        <compClass>CompAbilityEffect_GiveHediff</compClass>
        <hediffDef>Entad_RestfulCalm</hediffDef>
        <onlyApplyToSelf>true</onlyApplyToSelf>
      </li>
    </comps>
  </AbilityDef>

  <!-- Example of a furniture ability: a pawn walks to the furniture and uses it from the right-click menu.
       Never rolled at random (furniture traits use Use triggers instead); add it by name from the API or the dev
       tools to try the furniture ability code. -->
  <EntadFramework.EntadTraitDef>
    <defName>Entad_RestfulPause</defName>
    <label>Restful Pause</label>
    <description>A pawn can pause by it for a few seconds and come away with their pain halved for a while.</description>
    <categories>
      <li>Furniture</li>
    </categories>
    <rarity>Rare</rarity>
    <neverRandom>true</neverRandom>
    <abilityCastTicks>250</abilityCastTicks>
    <abilities>
      <li>Entad_RestfulSigh</li>
    </abilities>
  </EntadFramework.EntadTraitDef>
</Defs>
