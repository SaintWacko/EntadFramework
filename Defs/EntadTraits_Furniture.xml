<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Furniture traits: fuel, and Use triggers. A Use trigger only rolls on furniture that can be used that way
       (beds for Sleep, tables and chairs for Eat, workbenches for Work). -->
  <EntadFramework.EntadTraitDef>
    <defName>Entad_Bottomless</defName>
    <label>Bottomless</label>
    <description>Holds far more than it has any right to.</description>
    <categories><li>Furniture</li></categories>
    <rarity>Rare</rarity>
    <scalesWithRarity>true</scalesWithRarity>
    <buildingFactors>
      <li>
        <property>StorageCapacity</property>
        <min>1.5</min>
        <max>2</max>
      </li>
    </buildingFactors>
  </EntadFramework.EntadTraitDef>

  <EntadFramework.EntadTraitDef>
    <defName>Entad_Hayburner</defName>
    <label>Hayburner</label>
    <description>It isn't fussy about what goes into the fire.</description>
    <categories><li>Furniture</li></categories>
    <rarity>Uncommon</rarity>
    <fuelTypes><li>Hay</li></fuelTypes>
  </EntadFramework.EntadTraitDef>

  <EntadFramework.EntadTraitDef>
    <defName>Entad_ConvivialTable</defName>
    <label>Convivial</label>
    <description>Meals taken here feel like good company.</description>
    <categories><li>Furniture</li></categories>
    <rarity>Uncommon</rarity>
    <triggers>
      <li>
        <on>Use</on>
        <use>Eat</use>
        <thought>Entad_Thought_Convivial</thought>
      </li>
    </triggers>
  </EntadFramework.EntadTraitDef>
  <ThoughtDef>
    <defName>Entad_Thought_Convivial</defName>
    <durationDays>0.25</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>convivial meal</label>
        <description>That meal felt like a good dinner with friends.</description>
        <baseMoodEffect>4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <EntadFramework.EntadTraitDef>
    <defName>Entad_Dreamweaver</defName>
    <label>Dreamweaver</label>
    <description>Whoever sleeps here sometimes has wonderful dreams.</description>
    <categories><li>Furniture</li></categories>
    <rarity>Rare</rarity>
    <triggers>
      <li>
        <on>Use</on>
        <use>Sleep</use>
        <chance>0.3</chance>
        <thought>Entad_Thought_SweetDreams</thought>
      </li>
    </triggers>
  </EntadFramework.EntadTraitDef>
  <ThoughtDef>
    <defName>Entad_Thought_SweetDreams</defName>
    <durationDays>0.5</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>wonderful dream</label>
        <description>I had the most wonderful dream last night.</description>
        <baseMoodEffect>6</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <EntadFramework.EntadTraitDef>
    <defName>Entad_TirelessBench</defName>
    <label>Tireless</label>
    <description>Working here is oddly refreshing.</description>
    <categories><li>Furniture</li></categories>
    <rarity>Uncommon</rarity>
    <scalesWithRarity>true</scalesWithRarity>
    <triggers>
      <li>
        <on>Use</on>
        <use>Work</use>
        <rest>0.05~0.1</rest>
      </li>
    </triggers>
  </EntadFramework.EntadTraitDef>

  <EntadFramework.EntadTraitDef>
    <defName>Entad_Restful</defName>
    <label>Restful</label>
    <description>Some days, getting up from it feels like setting down a heavy load.</description>
    <categories><li>Furniture</li></categories>
    <rarity>Rare</rarity>
    <triggers>
      <li>
        <on>Use</on>
        <use>Eat, Work</use>
        <chance>0.25</chance>
        <hediff>Entad_RestfulCalm</hediff>
        <hediffHours>4</hediffHours>
      </li>
    </triggers>
  </EntadFramework.EntadTraitDef>

  <EntadFramework.EntadTraitDef>
    <defName>Entad_Captivating</defName>
    <label>Captivating</label>
    <description>Hard to walk away from, and you never regret the time.</description>
    <categories><li>Furniture</li></categories>
    <rarity>Uncommon</rarity>
    <triggers>
      <li>
        <on>Use</on>
        <use>Recreation</use>
        <thought>Entad_Thought_Captivated</thought>
      </li>
    </triggers>
  </EntadFramework.EntadTraitDef>
  <ThoughtDef>
    <defName>Entad_Thought_Captivated</defName>
    <durationDays>0.25</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>captivating fun</label>
        <description>I lost track of time there, and it was wonderful.</description>
        <baseMoodEffect>4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <EntadFramework.EntadTraitDef>
    <defName>Entad_Masterwork</defName>
    <label>Masterwork</label>
    <description>Work done here turns out better than the hands that did it.</description>
    <categories><li>Furniture</li></categories>
    <rarity>Rare</rarity>
    <scalesWithRarity>true</scalesWithRarity>
    <!-- Only on benches where something made has quality (StatAppliesTo) -->
    <statOffsets>
      <li><stat>Entad_ProductQualityChance</stat><min>0.1</min><max>0.2</max></li>
    </statOffsets>
  </EntadFramework.EntadTraitDef>

  <EntadFramework.EntadTraitDef>
    <defName>Entad_Abundant</defName>
    <label>Abundant</label>
    <description>Now and then it gives back more than was put in.</description>
    <categories><li>Furniture</li></categories>
    <rarity>Uncommon</rarity>
    <scalesWithRarity>true</scalesWithRarity>
    <!-- Only on benches where something made stacks (StatAppliesTo); only stacking products double -->
    <statOffsets>
      <li><stat>Entad_ProductDoubleChance</stat><min>0.08</min><max>0.12</max></li>
    </statOffsets>
  </EntadFramework.EntadTraitDef>

  <!-- Traits acting on their surroundings (EntadFurnitureEffects.cs). Plain stat traits: StatAppliesTo decides
       which items each can roll on. Warm and Cool push heat until their room reaches targetTemperature. -->
  <EntadFramework.EntadTraitDef>
    <defName>Entad_Luminous</defName>
    <label>Luminous</label>
    <description>A soft light hangs about it that no one ever lit.</description>
    <categories><li>Furniture</li></categories>
    <rarity>Uncommon</rarity>
    <scalesWithRarity>true</scalesWithRarity>
    <!-- Only on buildings without a light of their own; Bright scales those -->
    <statOffsets>
      <li><stat>Entad_GlowRadius</stat><min>6</min><max>9</max></li>
    </statOffsets>
  </EntadFramework.EntadTraitDef>

  <EntadFramework.EntadTraitDef>
    <defName>Entad_Warm</defName>
    <label>Warm</label>
    <description>Always warm to the touch, as if someone had just stood up from it.</description>
    <categories><li>Furniture</li></categories>
    <rarity>Uncommon</rarity>
    <scalesWithRarity>true</scalesWithRarity>
    <exclusiveWith><li>Entad_Cool</li></exclusiveWith>
    <targetTemperature>22</targetTemperature>
    <statOffsets>
      <li><stat>Entad_RoomHeating</stat><min>4</min><max>8</max></li>
    </statOffsets>
  </EntadFramework.EntadTraitDef>

  <EntadFramework.EntadTraitDef>
    <defName>Entad_Cool</defName>
    <label>Cool</label>
    <description>The air around it always feels like a cellar's.</description>
    <categories><li>Furniture</li></categories>
    <rarity>Uncommon</rarity>
    <scalesWithRarity>true</scalesWithRarity>
    <targetTemperature>18</targetTemperature>
    <statOffsets>
      <li><stat>Entad_RoomCooling</stat><min>4</min><max>8</max></li>
    </statOffsets>
  </EntadFramework.EntadTraitDef>

  <!-- Drawback the player can work around: a cooler (21 at full power, less when venting into hot air) mostly
       outpaces it, a second one always does, and outdoors or in an unroofed room it does nothing. Shares Warm's stat, so the two can't meet; Cool would cancel it. -->
  <EntadFramework.EntadTraitDef>
    <defName>Entad_Sweltering</defName>
    <label>Sweltering</label>
    <description>It gives off heat like a forge, and never cools down.</description>
    <categories><li>Furniture</li></categories>
    <rarity>Common</rarity>
    <points>-2</points>
    <exclusiveWith><li>Entad_Cool</li></exclusiveWith>
    <targetTemperature>40</targetTemperature>
    <statOffsets>
      <li><stat>Entad_RoomHeating</stat><min>10</min><max>15</max></li>
    </statOffsets>
  </EntadFramework.EntadTraitDef>

  <EntadFramework.EntadTraitDef>
    <defName>Entad_Preserving</defName>
    <label>Preserving</label>
    <description>What is put away here keeps, as though it had been forgotten by time as well as by the cook.</description>
    <categories><li>Furniture</li></categories>
    <rarity>Uncommon</rarity>
    <scalesWithRarity>true</scalesWithRarity>
    <!-- Only on storage that can hold something that rots -->
    <statFactors>
      <li><stat>Entad_StoredRotFactor</stat><min>0.5</min><max>0.7</max></li>
    </statFactors>
  </EntadFramework.EntadTraitDef>

  <EntadFramework.EntadTraitDef>
    <defName>Entad_Humble</defName>
    <label>Humble</label>
    <description>Nobody ever seems to think it is worth much, whatever the traders say.</description>
    <categories><li>Furniture</li><li>Apparel</li></categories>
    <rarity>Uncommon</rarity>
    <statFactors>
      <li><stat>Entad_ColonyWealthFactor</stat><min>0.1</min><max>0.3</max></li>
    </statFactors>
  </EntadFramework.EntadTraitDef>

  <EntadFramework.EntadTraitDef>
    <defName>Entad_Sparing</defName>
    <label>Sparing</label>
    <description>Some days the work seems to take only half of what was brought for it.</description>
    <categories><li>Furniture</li></categories>
    <rarity>Uncommon</rarity>
    <scalesWithRarity>true</scalesWithRarity>
    <!-- Only on benches with a bill that takes stackable ingredients -->
    <statOffsets>
      <li><stat>Entad_IngredientRefundChance</stat><min>0.1</min><max>0.2</max></li>
    </statOffsets>
  </EntadFramework.EntadTraitDef>

  <EntadFramework.EntadTraitDef>
    <defName>Entad_Fertile</defName>
    <label>Fertile</label>
    <description>Whatever is planted in it grows as if it had been waiting to.</description>
    <categories><li>Furniture</li></categories>
    <rarity>Uncommon</rarity>
    <scalesWithRarity>true</scalesWithRarity>
    <!-- Only on buildings plants grow in (plant pots, hydroponics) -->
    <statOffsets>
      <li><stat>Entad_FertilityOffset</stat><min>0.2</min><max>0.35</max></li>
    </statOffsets>
  </EntadFramework.EntadTraitDef>
</Defs>
