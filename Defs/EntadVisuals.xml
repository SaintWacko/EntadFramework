<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Flecks for trait visuals (EntadVisuals.cs): thrown off weapons and left behind shots. Small scales are set
       per visual; the textures are vanilla's soft glow and smoke, tinted here. -->
  <FleckDef ParentName="FleckBase_Thrown">
    <defName>Entad_Fleck_Ember</defName>
    <graphicData>
      <texPath>Things/Mote/FireGlow</texPath>
      <shaderType>MoteGlow</shaderType>
      <color>(1, 0.55, 0.2)</color>
    </graphicData>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <fadeInTime>0.08</fadeInTime>
    <solidTime>0.35</solidTime>
    <fadeOutTime>0.6</fadeOutTime>
  </FleckDef>

  <FleckDef ParentName="FleckBase_Thrown">
    <defName>Entad_Fleck_CinderSmoke</defName>
    <graphicData>
      <texPath>Things/Mote/Smoke</texPath>
      <color>(0.25, 0.22, 0.2, 0.45)</color>
    </graphicData>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <fadeInTime>0.2</fadeInTime>
    <solidTime>0.3</solidTime>
    <fadeOutTime>1.2</fadeOutTime>
    <growthRate>0.35</growthRate>
  </FleckDef>

  <!-- Grey smoke rising off a wearer. Stronger than the weapon smoke: it starts over the pawn's own sprite, where
       a faint puff disappears against the clothes. -->
  <FleckDef ParentName="FleckBase_Thrown">
    <defName>Entad_Fleck_SmokeWisp</defName>
    <graphicData>
      <texPath>Things/Mote/Smoke</texPath>
      <color>(0.32, 0.3, 0.29, 0.6)</color>
    </graphicData>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <fadeInTime>0.25</fadeInTime>
    <solidTime>0.35</solidTime>
    <fadeOutTime>1.5</fadeOutTime>
    <growthRate>0.45</growthRate>
  </FleckDef>

  <!-- Frost mist for worn gear: denser than the weapon mist for the same reason as the smoke above -->
  <FleckDef ParentName="FleckBase_Thrown">
    <defName>Entad_Fleck_FrostMistWorn</defName>
    <graphicData>
      <texPath>Things/Mote/Smoke</texPath>
      <color>(0.8, 0.92, 1, 0.75)</color>
    </graphicData>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <fadeInTime>0.2</fadeInTime>
    <solidTime>0.4</solidTime>
    <fadeOutTime>1.4</fadeOutTime>
    <growthRate>0.4</growthRate>
  </FleckDef>

  <FleckDef ParentName="FleckBase_Thrown">
    <defName>Entad_Fleck_Static</defName>
    <graphicData>
      <texPath>Things/Mote/FireGlow</texPath>
      <shaderType>MoteGlow</shaderType>
      <color>(0.55, 0.75, 1)</color>
    </graphicData>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <fadeInTime>0.02</fadeInTime>
    <solidTime>0.08</solidTime>
    <fadeOutTime>0.25</fadeOutTime>
  </FleckDef>

  <FleckDef ParentName="FleckBase_Thrown">
    <defName>Entad_Fleck_FrostMist</defName>
    <graphicData>
      <texPath>Things/Mote/Smoke</texPath>
      <color>(0.82, 0.93, 1, 0.45)</color>
    </graphicData>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <fadeInTime>0.3</fadeInTime>
    <solidTime>0.2</solidTime>
    <fadeOutTime>1.2</fadeOutTime>
    <growthRate>0.25</growthRate>
  </FleckDef>

  <FleckDef ParentName="FleckBase_Thrown">
    <defName>Entad_Fleck_FrostGlint</defName>
    <graphicData>
      <texPath>Things/Mote/EntadGlint</texPath>
      <shaderType>MoteGlow</shaderType>
      <color>(0.4, 0.68, 1)</color>
    </graphicData>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <fadeInTime>0.15</fadeInTime>
    <solidTime>0.05</solidTime>
    <fadeOutTime>0.35</fadeOutTime>
  </FleckDef>

  <!-- One-off effects (EntadEventVisuals.cs): hit flashes, pulses, and wisps that fly from one pawn to another.
       A wisp flies at a set speed and its solid time is stretched so it fades out as it reaches the target. -->
  <FleckDef ParentName="FleckBase_Thrown">
    <defName>Entad_Fleck_BurnFlash</defName>
    <graphicData>
      <texPath>Things/Mote/FireGlow</texPath>
      <shaderType>MoteGlow</shaderType>
      <color>(1, 0.85, 0.5)</color>
    </graphicData>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <fadeInTime>0.03</fadeInTime>
    <solidTime>0.06</solidTime>
    <fadeOutTime>0.35</fadeOutTime>
    <growthRate>1.2</growthRate>
  </FleckDef>

  <!-- A tongue of vanilla's fire rising off a burn hit. Drawn as it is rather than added like a glow, which on its
       own reads as a red blot over the pawn. The texture is set to Things/Special/Fire/FireA at startup
       (EntadFlameLick): written here, the asset pipeline stubs that path with a placeholder that shadows vanilla's
       fire, weapon flames included. -->
  <FleckDef ParentName="FleckBase_Thrown">
    <defName>Entad_Fleck_FlameLick</defName>
    <graphicData>
      <texPath>Things/Mote/FireGlow</texPath>
    </graphicData>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <fadeInTime>0.05</fadeInTime>
    <solidTime>0.15</solidTime>
    <fadeOutTime>0.3</fadeOutTime>
    <growthRate>-0.3</growthRate>
  </FleckDef>

  <FleckDef ParentName="FleckBase_Thrown">
    <defName>Entad_Fleck_StunFlash</defName>
    <graphicData>
      <texPath>Things/Mote/SparkFlash</texPath>
      <shaderType>MoteGlow</shaderType>
      <color>(1, 0.95, 0.6)</color>
    </graphicData>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <fadeInTime>0.02</fadeInTime>
    <solidTime>0.05</solidTime>
    <fadeOutTime>0.25</fadeOutTime>
  </FleckDef>

  <FleckDef ParentName="FleckBase_Thrown">
    <defName>Entad_Fleck_BloodWisp</defName>
    <graphicData>
      <texPath>Things/Mote/FireGlow</texPath>
      <shaderType>MoteGlow</shaderType>
      <color>(0.85, 0.1, 0.12)</color>
    </graphicData>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <fadeInTime>0.1</fadeInTime>
    <solidTime>0.6</solidTime>
    <fadeOutTime>0.12</fadeOutTime>
  </FleckDef>

  <FleckDef ParentName="FleckBase_Thrown">
    <defName>Entad_Fleck_HealPulse</defName>
    <graphicData>
      <texPath>Things/Mote/FireGlow</texPath>
      <shaderType>MoteGlow</shaderType>
      <color>(0.35, 1, 0.45)</color>
    </graphicData>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <fadeInTime>0.1</fadeInTime>
    <solidTime>0.1</solidTime>
    <fadeOutTime>0.6</fadeOutTime>
    <growthRate>1.5</growthRate>
  </FleckDef>

  <FleckDef ParentName="FleckBase_Thrown">
    <defName>Entad_Fleck_HealMote</defName>
    <graphicData>
      <texPath>Things/Mote/FireGlow</texPath>
      <shaderType>MoteGlow</shaderType>
      <color>(0.45, 1, 0.55)</color>
    </graphicData>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <fadeInTime>0.1</fadeInTime>
    <solidTime>0.3</solidTime>
    <fadeOutTime>0.5</fadeOutTime>
  </FleckDef>

  <FleckDef ParentName="FleckBase_Thrown">
    <defName>Entad_Fleck_SurgeFlash</defName>
    <graphicData>
      <texPath>Things/Mote/FireGlow</texPath>
      <shaderType>MoteGlow</shaderType>
      <color>(1, 0.88, 0.5)</color>
    </graphicData>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <fadeInTime>0.05</fadeInTime>
    <solidTime>0.08</solidTime>
    <fadeOutTime>0.4</fadeOutTime>
    <growthRate>1.8</growthRate>
  </FleckDef>

  <!-- Mirrored's sheen: a cold white glint off polished metal -->
  <FleckDef ParentName="FleckBase_Thrown">
    <defName>Entad_Fleck_MirrorGlint</defName>
    <graphicData>
      <texPath>Things/Mote/EntadGlint</texPath>
      <shaderType>MoteGlow</shaderType>
      <color>(0.92, 0.96, 1)</color>
    </graphicData>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <fadeInTime>0.1</fadeInTime>
    <solidTime>0.05</solidTime>
    <fadeOutTime>0.3</fadeOutTime>
  </FleckDef>

  <FleckDef ParentName="FleckBase_Thrown">
    <defName>Entad_Fleck_GoldGlint</defName>
    <graphicData>
      <texPath>Things/Mote/EntadGlint</texPath>
      <shaderType>MoteGlow</shaderType>
      <color>(1, 0.85, 0.45)</color>
    </graphicData>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <fadeInTime>0.15</fadeInTime>
    <solidTime>0.1</solidTime>
    <fadeOutTime>0.4</fadeOutTime>
  </FleckDef>

  <!-- Dark blood closing over a wound: drawn over the pawn rather than added like a glow, which a dark red barely shows as -->
  <FleckDef ParentName="FleckBase_Thrown">
    <defName>Entad_Fleck_ClotPulse</defName>
    <graphicData>
      <texPath>Things/Mote/FireGlow</texPath>
      <shaderType>Transparent</shaderType>
      <color>(0.5, 0.03, 0.05, 0.75)</color>
    </graphicData>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <fadeInTime>0.08</fadeInTime>
    <solidTime>0.1</solidTime>
    <fadeOutTime>0.5</fadeOutTime>
    <growthRate>1.0</growthRate>
  </FleckDef>

  <!-- Furniture (EntadBuildingVisuals.cs): ambient effects off installed buildings. Heat shimmer bends the air
       over a warm building with vanilla's heat-wave distortion, much slower and fainter than a hellfire blast. -->
  <FleckDef ParentName="FleckGlowDistortBackground" Name="EntadHeatShimmerBase">
    <defName>Entad_Fleck_HeatShimmer</defName>
    <fleckSystemClass>FleckSystemThrown</fleckSystemClass>
    <altitudeLayer>MoteOverheadLow</altitudeLayer>
    <graphicData>
      <texPath>Things/Mote/Black</texPath>
      <shaderParameters>
        <_distortionIntensity>0.012</_distortionIntensity>
        <_brightnessMultiplier>1.0</_brightnessMultiplier>
        <_DistortionTex>/Things/Mote/MoteHellfireCannon_HeatWaveDistortion</_DistortionTex>
      </shaderParameters>
    </graphicData>
    <fadeInTime>0.6</fadeInTime>
    <solidTime>0.5</solidTime>
    <fadeOutTime>0.9</fadeOutTime>
    <growthRate>0.25</growthRate>
  </FleckDef>

  <FleckDef ParentName="EntadHeatShimmerBase">
    <defName>Entad_Fleck_HeatShimmerStrong</defName>
    <graphicData>
      <shaderParameters>
        <_distortionIntensity>0.022</_distortionIntensity>
      </shaderParameters>
    </graphicData>
  </FleckDef>

  <!-- A dull red glow breathing off a sweltering building, added like light, so it is kept dim -->
  <FleckDef ParentName="FleckBase_Thrown">
    <defName>Entad_Fleck_HeatHaze</defName>
    <graphicData>
      <texPath>Things/Mote/FireGlow</texPath>
      <shaderType>MoteGlow</shaderType>
      <color>(0.4, 0.15, 0.05)</color>
    </graphicData>
    <altitudeLayer>MoteOverheadLow</altitudeLayer>
    <fadeInTime>0.8</fadeInTime>
    <solidTime>0.4</solidTime>
    <fadeOutTime>1.2</fadeOutTime>
    <growthRate>0.2</growthRate>
  </FleckDef>

  <!-- Small orange sparks dripping off a building whose network leaks -->
  <FleckDef ParentName="FleckBase_Thrown">
    <defName>Entad_Fleck_LeakSpark</defName>
    <graphicData>
      <texPath>Things/Mote/FireGlow</texPath>
      <shaderType>MoteGlow</shaderType>
      <color>(1, 0.6, 0.2)</color>
    </graphicData>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <fadeInTime>0.02</fadeInTime>
    <solidTime>0.15</solidTime>
    <fadeOutTime>0.35</fadeOutTime>
  </FleckDef>

  <FleckDef ParentName="FleckBase_Thrown">
    <defName>Entad_Fleck_GrowthMote</defName>
    <graphicData>
      <texPath>Things/Mote/FireGlow</texPath>
      <shaderType>MoteGlow</shaderType>
      <color>(0.4, 0.95, 0.35)</color>
    </graphicData>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <fadeInTime>0.4</fadeInTime>
    <solidTime>0.8</solidTime>
    <fadeOutTime>0.8</fadeOutTime>
  </FleckDef>

  <!-- Barren's motes: Fertile's, black. Drawn over the plant rather than added like a glow, which black can't be. -->
  <FleckDef ParentName="FleckBase_Thrown">
    <defName>Entad_Fleck_BlightMote</defName>
    <graphicData>
      <texPath>Things/Mote/FireGlow</texPath>
      <shaderType>Transparent</shaderType>
      <color>(0.02, 0.015, 0.02, 1)</color>
    </graphicData>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <fadeInTime>0.4</fadeInTime>
    <solidTime>0.8</solidTime>
    <fadeOutTime>0.8</fadeOutTime>
  </FleckDef>

  <!-- Greenish-brown fumes off food going off on a spoiling shelf -->
  <FleckDef ParentName="FleckBase_Thrown">
    <defName>Entad_Fleck_SpoilFume</defName>
    <graphicData>
      <texPath>Things/Mote/Smoke</texPath>
      <color>(0.45, 0.5, 0.15, 0.75)</color>
    </graphicData>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <fadeInTime>0.4</fadeInTime>
    <solidTime>0.8</solidTime>
    <fadeOutTime>1.4</fadeOutTime>
    <growthRate>0.3</growthRate>
  </FleckDef>

  <FleckDef ParentName="FleckBase_Thrown">
    <defName>Entad_Fleck_DreadWisp</defName>
    <graphicData>
      <texPath>Things/Mote/Smoke</texPath>
      <color>(0.12, 0.07, 0.16, 0.65)</color>
    </graphicData>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <fadeInTime>0.15</fadeInTime>
    <solidTime>0.3</solidTime>
    <fadeOutTime>0.9</fadeOutTime>
    <growthRate>0.5</growthRate>
  </FleckDef>
</Defs>
