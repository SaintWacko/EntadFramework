<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Reloading a reloadable entad ability (EntadReload.cs). Same shape as vanilla's Reload job. -->
  <JobDef>
    <defName>EF_EntadReload</defName>
    <driverClass>EntadFramework.JobDriver_EntadReload</driverClass>
    <reportString>reloading TargetA.</reportString>
    <suspendable>false</suspendable>
    <allowOpportunisticPrefix>true</allowOpportunisticPrefix>
  </JobDef>
</Defs>
