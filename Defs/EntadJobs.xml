<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- A pawn walks to entad furniture and uses one of its abilities (EntadFurnitureAbilities.cs) -->
  <JobDef>
    <defName>Entad_UseFurnitureAbility</defName>
    <driverClass>EntadFramework.JobDriver_UseEntadFurniture</driverClass>
    <reportString>activating TargetA.</reportString>
    <allowOpportunisticPrefix>false</allowOpportunisticPrefix>
  </JobDef>

  <!-- Reloading a reloadable entad ability (EntadReload.cs). Same shape as vanilla's Reload job. -->
  <JobDef>
    <defName>Entad_Reload</defName>
    <driverClass>EntadFramework.JobDriver_EntadReload</driverClass>
    <reportString>reloading TargetA.</reportString>
    <suspendable>false</suspendable>
    <allowOpportunisticPrefix>true</allowOpportunisticPrefix>
  </JobDef>

  <!-- Walking up to a caravan's entad appraiser to open the appraisal window (EntadAppraisal.cs) -->
  <JobDef>
    <defName>Entad_Appraise</defName>
    <driverClass>EntadFramework.JobDriver_EntadAppraise</driverClass>
    <reportString>talking to TargetA.</reportString>
    <casualInterruptible>false</casualInterruptible>
  </JobDef>

  <!-- Capturing, placing or picking up a portable space (EntadPortableSpace.cs) -->
  <JobDef>
    <defName>Entad_UsePortableSpace</defName>
    <driverClass>EntadFramework.JobDriver_UsePortableSpace</driverClass>
    <reportString>unfolding a portable space.</reportString>
    <casualInterruptible>false</casualInterruptible>
    <allowOpportunisticPrefix>false</allowOpportunisticPrefix>
  </JobDef>

  <!-- Dismantling an entad for verity (EntadDismantle.cs): designated from the item's gizmo, done as Research -->
  <JobDef>
    <defName>Entad_DismantleJob</defName>
    <driverClass>EntadFramework.JobDriver_DismantleEntad</driverClass>
    <reportString>dismantling TargetA.</reportString>
    <allowOpportunisticPrefix>true</allowOpportunisticPrefix>
  </JobDef>

  <DesignationDef>
    <defName>Entad_Dismantle</defName>
    <texturePath>Designations/EntadDismantle</texturePath>
    <targetType>Thing</targetType>
  </DesignationDef>

  <WorkGiverDef>
    <defName>Entad_DismantleEntad</defName>
    <label>dismantle entads</label>
    <giverClass>EntadFramework.WorkGiver_DismantleEntad</giverClass>
    <workType>Research</workType>
    <verb>dismantle</verb>
    <gerund>dismantling</gerund>
    <!-- Ahead of research at a bench (100), which never runs out -->
    <priorityInType>110</priorityInType>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
    <canBeDoneByMechs>false</canBeDoneByMechs>
  </WorkGiverDef>
</Defs>
