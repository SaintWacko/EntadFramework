<Project Sdk="Microsoft.NET.Sdk">
    <!--
        RimWorld 1.7 build of the main assembly. Same shared C# as 1.6/Source (the mod's top-level Source/ folder),
        compiled with RW17 defined. Output goes to 1.7/Assemblies, which LoadFolders.xml loads only on 1.7.

        The game references come from the Krafs.Rimworld.Ref 1.7 package, so this builds without a 1.7 install.
        That package only targets net10.0, which a net472 project can't take as a PackageReference, so it is
        downloaded as-is (PackageDownload) and its DLLs are referenced by path. Mounted Weapons does the same thing
        against the installed 1.7 game instead.
    -->
    <PropertyGroup>
        <OutputType>Library</OutputType>
        <TargetFramework>net472</TargetFramework>
        <RootNamespace>EntadFramework</RootNamespace>
        <AssemblyName>EntadFramework</AssemblyName>
        <LangVersion>latest</LangVersion>
        <Deterministic>true</Deterministic>
        <OutputPath>..\Assemblies\</OutputPath>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
        <DefineConstants>$(DefineConstants);RW17</DefineConstants>
        <!-- Keep in step with 1.6/Source -->
        <Version>1.0.0</Version>
        <AssemblyVersion>1.0.0.0</AssemblyVersion>
        <FileVersion>1.0.0.0</FileVersion>
        <Product>Entad Framework</Product>
        <Authors>SaintWacko</Authors>
        <!-- Pinned: the 1.7 reference packages are prereleases, and a new one can change the API -->
        <RW17RefVersion>1.7.4979-alpha</RW17RefVersion>
        <RW17Ref>$(NuGetPackageRoot)krafs.rimworld.ref/$(RW17RefVersion)/ref/net10.0/</RW17Ref>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <Optimize>true</Optimize>
        <DebugType>none</DebugType>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
        <Optimize>false</Optimize>
        <DebugType>portable</DebugType>
    </PropertyGroup>

    <ItemGroup>
        <!-- Top level only: obj/ under Source holds generated files. -->
        <Compile Include="..\..\Source\*.cs" />
        <!-- The ability AI, kept in its own folder with no reference to any Entad type so it can be copied into
             another mod (Bastle Framework) as it is. -->
        <Compile Include="..\..\Source\AbilityAI\*.cs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
        <PackageDownload Include="Krafs.Rimworld.Ref" Version="[$(RW17RefVersion)]" />
        <!-- Compile-only, as in 1.6/Source: the Harmony mod supplies the runtime DLL -->
        <PackageReference Include="Lib.Harmony" Version="2.4.1">
            <PrivateAssets>all</PrivateAssets>
            <ExcludeAssets>runtime</ExcludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <Reference Include="Assembly-CSharp">
            <HintPath>$(RW17Ref)Assembly-CSharp.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine">
            <HintPath>$(RW17Ref)UnityStubs.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Waylith">
            <HintPath>$(RW17Ref)Waylith.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>
</Project>
